// Float direction (T029, T032), laid out as the previous app: title bar above, toolbar over the top
// of the video, a dock on each side, capture info in the corners the user picks. Toolbar, docks and
// the unpinned info hide 2 s after the pointer leaves them and come back when it reaches the top
// of the video or a pinned bubble.
// The lists come from Rust (real devices and modes); window controls are wired in T037.
import { Theme } from "../theme.slint";
import { Raised } from "../components/surface.slint";
import { Tier } from "../components/basics.slint";
import { TitleBar } from "../components/title-bar.slint";
import { ViewDock, ActionDock } from "../components/dock.slint";
import { DropItem } from "../components/dropdown.slint";
import { Toolbar } from "../components/toolbar.slint";
import { InfoOverlay } from "../components/info-overlay.slint";
import { WindowState, VideoRect } from "../window-state.slint";
import { Texts } from "../texts.slint";

export component Float inherits Window {
    // Devices only: screens and windows are sources of recording and streaming, not the preview.
    in property <[DropItem]> devices;
    in property <[DropItem]> audio-inputs;
    in property <[DropItem]> modes;
    in property <int> device;
    in property <int> audio-input;
    in property <int> mode;
    // The running mode, for the info overlay.
    in property <string> resolution;
    in property <string> badge;
    in property <Tier> tier: Tier.other;
    in property <int> fps;
    // No device found: a message over the video area says what to do next.
    in property <bool> no-device;
    out property <bool> menu-open: toolbar.menu-open;
    // The dock's toggle; the loop draws the ambient light behind the video while it is on (T034).
    in-out property <bool> ambient-light <=> left-dock.ambient-light;
    // The language button (T036): Rust selects the bundled translation.
    callback select-language(string);

    public function close-menus() {
        toolbar.close-menus();
    }

    background: transparent;
    default-font-family: Theme.font;

    // The title bar hides in fullscreen; the video starts below it, never behind it.
    property <length> bar: WindowState.fullscreen ? 0 : 32px;
    out property <VideoRect> video-area: { x: 0, y: root.bar, width: root.width, height: root.height - root.bar, radius: 0 };
    property <bool> active: true;
    property <bool> engaged: top-zone.has-hover || toolbar-area.has-hover || left-area.has-hover
        || right-area.has-hover || toolbar.menu-open || info.engaged;
    changed engaged => {
        if (self.engaged) {
            self.active = true;
        }
    }

    Timer {
        interval: 2s;
        running: root.active && !root.engaged;
        triggered => {
            root.active = false;
            toolbar.close-menus();
        }
    }

    if root.no-device: Raised {
        x: (root.width - self.width) / 2;
        y: root.bar + (root.height - root.bar - self.height) / 2;
        width: min(message.preferred-width + 2 * Theme.gap-xl, root.width - 2 * Theme.gap-xl);
        height: message.preferred-height + 2 * Theme.gap-l;
        message := Text {
            width: parent.width - 2 * Theme.gap-xl;
            text: @tr("No capture device found. Connect a capture card or a webcam and start again, or run with --test-video.");
            color: Theme.c.text;
            font-size: Theme.text-m;
            horizontal-alignment: center;
            wrap: word-wrap;
        }
    }

    // Reaching the top of the video brings the chrome back.
    top-zone := TouchArea {
        x: 0;
        y: root.bar;
        width: root.width;
        height: 100px;
    }

    // Closes an open menu on a click anywhere else.
    if toolbar.menu-open: TouchArea {
        clicked => { toolbar.close-menus(); }
    }

    // The bubbles the user arranged (T035); in the top corners they sit below the open toolbar.
    info := InfoOverlay {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        open: root.active;
        top: root.bar + (root.active ? toolbar.height + Theme.gap-m : Theme.gap-xl);
        capturing: !root.no-device;
        resolution: root.resolution;
        badge: root.badge;
        tier: root.tier;
        fps: root.fps;
        // Sample value: the live latency is not measured by the app.
        latency-ms: 23;
    }

    left-area := TouchArea {
        x: root.active ? 12px : -self.width - 40px;
        y: root.bar + (root.height - root.bar - self.height) / 2;
        width: left-dock.width;
        height: left-dock.height;
        animate x { duration: 300ms; easing: ease-out; }
        left-dock := ViewDock {
            fullscreen: WindowState.fullscreen;
            toggle-fullscreen => { WindowState.toggle-fullscreen(); }
        }
    }

    right-area := TouchArea {
        x: root.active ? root.width - self.width - 12px : root.width + 40px;
        y: root.bar + (root.height - root.bar - self.height) / 2;
        width: right-dock.width;
        height: right-dock.height;
        animate x { duration: 300ms; easing: ease-out; }
        right-dock := ActionDock { }
    }

    toolbar-area := TouchArea {
        x: 0;
        y: root.active ? root.bar : root.bar - self.height - 40px;
        width: root.width;
        height: toolbar.height;
        animate y { duration: 300ms; easing: ease-out; }

        toolbar := Toolbar {
            devices: root.devices;
            audio-inputs: root.audio-inputs;
            modes: root.modes;
            device: root.device;
            audio-input: root.audio-input;
            mode: root.mode;
            room: root.height - root.bar;
        }

        // Runtime language switch (T036), left of the theme switch. Each language is named in itself.
        Raised {
            x: theme-switch.x - self.width - Theme.gap-m;
            y: (parent.height - self.height) / 2;
            width: 132px;
            height: 48px;
            fill: Theme.c.top;
            TouchArea {
                clicked => { root.select-language(Texts.language == "en" ? "pt-BR" : "en"); }
            }
            Text {
                text: Texts.language == "en" ? "Português" : "English";
                color: Theme.c.text;
                font-size: Theme.text-m;
                font-weight: 600;
            }
        }

        // Runtime theme switch (T032), at the toolbar's right end.
        theme-switch := Raised {
            x: parent.width - self.width - Theme.gap-l;
            y: (parent.height - self.height) / 2;
            width: 132px;
            height: 48px;
            fill: Theme.c.top;
            TouchArea {
                clicked => { Theme.dark = !Theme.dark; }
            }
            Text {
                text: Theme.dark ? @tr("Light theme") : @tr("Dark theme");
                color: Theme.c.text;
                font-size: Theme.text-m;
                font-weight: 600;
            }
        }
    }

    // Last, so the hidden toolbar slides under it.
    if !WindowState.fullscreen: TitleBar {
        x: 0;
        y: 0;
        width: root.width;
    }
}
