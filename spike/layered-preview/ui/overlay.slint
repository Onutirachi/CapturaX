// UI layer drawn by Slint's software renderer over the video (research R13).
// Transparent background: only the elements below are composited over the video.
import { Button } from "std-widgets.slint";

export component Overlay inherits Window {
    in property <string> info;
    in-out property <int> clicks;
    background: transparent;

    Rectangle {
        x: 24px;
        y: parent.height - self.height - 24px;
        width: row.preferred-width + 32px;
        height: row.preferred-height + 24px;
        border-radius: 14px;
        background: #101014cc;

        row := HorizontalLayout {
            padding: 12px;
            spacing: 16px;
            alignment: start;

            Text {
                text: root.info;
                color: #ffffff;
                font-size: 16px;
                vertical-alignment: center;
            }

            Button {
                text: "Clicks: " + root.clicks;
                clicked => { root.clicks += 1; }
            }
        }
    }
}
