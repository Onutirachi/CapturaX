// Theme samples (T027): the dark and light palettes side by side, over the video.
import { Theme, Palette, Palettes } from "theme.slint";
import { Raised } from "components/surface.slint";

component Swatch inherits VerticalLayout {
    in property <Palette> c;
    in property <color> tone;
    in property <string> name;
    spacing: 4px;
    Rectangle { width: 64px; height: 44px; border-radius: Theme.radius-s; background: root.tone; }
    Text { text: root.name; color: root.c.text-faint; font-size: Theme.text-s; }
}

component Badge inherits Rectangle {
    in property <string> text;
    in property <color> tint;
    width: label.preferred-width + 10px;
    height: label.preferred-height + 2px;
    border-radius: 4px;
    background: root.tint;
    label := Text { text: root.text; color: #ffffff; font-size: Theme.text-s; font-weight: 600; }
}

component Sample inherits Rectangle {
    in property <Palette> c;
    in property <bool> dark;
    in property <string> title;
    border-radius: Theme.radius-l;
    background: c.base;

    VerticalLayout {
        padding: 24px;
        spacing: Theme.gap-l;

        Text { text: root.title; color: root.c.text; font-size: Theme.text-xl; font-weight: 700; }

        HorizontalLayout {
            spacing: Theme.gap-m;
            alignment: start;
            Swatch { c: root.c; tone: root.c.deep; name: "deep"; }
            Swatch { c: root.c; tone: root.c.base; name: "base"; }
            Swatch { c: root.c; tone: root.c.raised; name: "raised"; }
            Swatch { c: root.c; tone: root.c.top; name: "top"; }
            Swatch { c: root.c; tone: root.c.accent; name: "accent"; }
        }

        VerticalLayout {
            spacing: 2px;
            Text { text: "Full HD · 60 FPS"; color: root.c.text; font-size: Theme.text-l; font-weight: 600; }
            Text { text: "ezcap Live Gamer Ultra"; color: root.c.text-muted; font-size: Theme.text-m; }
            Text { text: "Capturing since 21:04"; color: root.c.text-faint; font-size: Theme.text-s; }
            Text { text: "● REC 00:12:41"; color: root.c.accent-text; font-size: Theme.text-m; font-weight: 600; }
        }

        // A sunken well holding raised controls: depth by tone and shadow only.
        Rectangle {
            height: 92px;
            border-radius: Theme.radius-m;
            background: root.c.deep;
            HorizontalLayout {
                padding: 18px;
                spacing: 18px;
                alignment: start;
                Raised {
                    c: root.c;
                    fill: root.c.top;
                    width: 120px;
                    Text { text: "Record"; color: root.c.text; font-size: Theme.text-m; font-weight: 600; }
                }
                Raised {
                    c: root.c;
                    fill: hover.has-hover ? root.c.accent-hover : root.c.accent;
                    width: 120px;
                    hover := TouchArea { }
                    Text { text: "Go live"; color: root.c.on-accent; font-size: Theme.text-m; font-weight: 700; }
                }
                Raised {
                    c: root.c;
                    fill: root.c.top;
                    elevation: 0;
                    width: 120px;
                    Text { text: "Flat"; color: root.c.text-muted; font-size: Theme.text-m; }
                }
                // Keyboard focus: a solid 2px ring 2px outside the control, the one allowed outline.
                Rectangle {
                    width: 120px;
                    Rectangle {
                        x: -4px; y: -4px; width: parent.width + 8px; height: parent.height + 8px;
                        border-radius: Theme.radius-m + 4px;
                        border-width: 2px;
                        border-color: root.c.accent-text;
                    }
                    Raised {
                        c: root.c;
                        fill: root.c.top;
                        Text { text: "Focused"; color: root.c.text; font-size: Theme.text-m; font-weight: 600; }
                    }
                }
            }
        }

        HorizontalLayout {
            spacing: Theme.gap-m;
            alignment: start;
            Badge { text: "HD"; tint: Theme.badge-hd; }
            Badge { text: "Full HD"; tint: Theme.badge-full-hd; }
            Badge { text: "QHD"; tint: Theme.badge-qhd; }
            Badge { text: "4K"; tint: Theme.badge-4k; }
            Badge { text: "16:10"; tint: Theme.badge-other; }
            Rectangle { width: 8px; }
            Text { text: "● OK"; color: root.c.ok; font-size: Theme.text-m; }
            Text { text: "● Warn"; color: root.c.warn; font-size: Theme.text-m; }
            Text { text: "● Error"; color: root.c.bad; font-size: Theme.text-m; }
        }

        Image {
            height: 34px;
            source: root.dark ? @image-url("assets/CapturaX-light.svg") : @image-url("assets/CapturaX-dark.svg");
            horizontal-alignment: left;
        }
    }
}

export component ThemeTest inherits Window {
    in property <string> info;
    background: transparent;
    default-font-family: Theme.font;

    HorizontalLayout {
        padding: 24px;
        spacing: 24px;
        alignment: center;
        Sample { c: Palettes.dark; dark: true; title: "Dark"; width: 600px; height: self.preferred-height; }
        Sample { c: Palettes.light; title: "Light"; width: 600px; height: self.preferred-height; }
    }

    // Panels over the video: the semi-transparent panel tone and the info bubbles.
    HorizontalLayout {
        y: parent.height - self.height - 24px;
        height: 56px;
        padding-left: 24px;
        padding-right: 24px;
        spacing: 24px;

        Rectangle {
            border-radius: Theme.radius-m;
            background: Palettes.dark.panel;
            Text { text: "Dark panel"; color: Palettes.dark.text; font-size: Theme.text-m; }
        }

        Rectangle {
            border-radius: Theme.radius-m;
            background: Palettes.light.panel;
            Text { text: "Light panel"; color: Palettes.light.text; font-size: Theme.text-m; }
        }

        Rectangle {
            border-radius: Theme.radius-m;
            background: Theme.info-bubble;
            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                spacing: 8px;
                alignment: center;
                Text { text: root.info; color: Theme.info-text; font-size: Theme.text-m; vertical-alignment: center; }
                Badge { y: (parent.height - self.height) / 2; text: "Full HD"; tint: Theme.badge-full-hd; }
            }
        }
    }
}
