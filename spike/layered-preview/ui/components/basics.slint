// Small building blocks shared by every direction (T028): badge, tooltip, icon button.
import { Theme } from "../theme.slint";
import { Raised } from "surface.slint";

// Resolution tier of a source; picks the badge color.
export enum Tier { hd, full-hd, qhd, uhd, other }

// Where a tooltip or popover opens, relative to its control.
export enum Side { top, right, left }

export component Badge inherits Rectangle {
    in property <string> text;
    in property <Tier> tier: Tier.other;
    width: label.preferred-width + 10px;
    height: label.preferred-height + 2px;
    border-radius: 4px;
    background: tier == Tier.hd ? Theme.badge-hd
        : tier == Tier.full-hd ? Theme.badge-full-hd
        : tier == Tier.qhd ? Theme.badge-qhd
        : tier == Tier.uhd ? Theme.badge-4k
        : Theme.badge-other;

    label := Text {
        text: root.text;
        color: #ffffff;
        font-size: Theme.text-s;
        font-weight: 600;
    }
}

// Opaque hint shown above a control after a short hover; longer text lives here, not in labels.
export component Tooltip inherits Raised {
    in property <string> text;
    in property <bool> show;
    fill: Theme.c.top;
    width: label.preferred-width + 20px;
    height: label.preferred-height + 12px;
    opacity: show ? 1 : 0;
    visible: self.opacity > 0;
    animate opacity { duration: Theme.quick; }

    label := Text {
        text: root.text;
        color: Theme.c.text;
        font-size: Theme.text-s;
    }
}

// Square icon control. `active` marks a toggled state; with `primary` it fills with the accent
// (recording, live). The tooltip appears above after 500 ms of hover. Disabled, it fades and
// ignores clicks.
export component IconButton inherits Rectangle {
    in property <image> icon;
    in property <string> tooltip;
    in property <bool> active;
    in property <bool> primary;
    in property <length> size: 44px;
    in property <bool> enabled: true;
    // Where the tooltip opens: towards the inside of the window.
    in property <Side> tooltip-side: Side.top;
    out property <bool> hovered: area.has-hover;
    callback clicked;

    property <bool> show-tip;
    width: size;
    height: size;
    border-radius: Theme.radius-m;
    background: active && primary ? (area.has-hover ? Theme.c.accent-hover : Theme.c.accent)
        : active ? Theme.c.accent-soft
        : area.pressed ? Theme.c.press
        : area.has-hover ? Theme.c.hover
        : transparent;
    animate background { duration: Theme.quick; }
    opacity: enabled ? 1 : 0.35;

    Image {
        source: root.icon;
        width: 22px;
        height: 22px;
        // A toggled tool (ambient light, preview hidden) shows its state in the icon color.
        colorize: root.active && root.primary ? Theme.c.on-accent : root.active ? Theme.c.accent-icon : Theme.c.text;
    }

    area := TouchArea {
        enabled: root.enabled;
        clicked => {
            root.show-tip = false;
            root.clicked();
        }
        changed has-hover => {
            if (!self.has-hover) {
                root.show-tip = false;
            }
        }
    }

    Timer {
        interval: 500ms;
        running: area.has-hover && !root.show-tip;
        triggered => {
            root.show-tip = true;
        }
    }

    Tooltip {
        text: root.tooltip;
        show: root.show-tip && root.tooltip != "";
        x: root.tooltip-side == Side.right ? root.width + 10px
            : root.tooltip-side == Side.left ? -self.width - 10px
            : (root.width - self.width) / 2;
        y: root.tooltip-side == Side.top ? -self.height - 10px : (root.height - self.height) / 2;
    }
}
