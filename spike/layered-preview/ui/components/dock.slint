// The two docks (T028), as in the previous app: vertical panels on the window's sides.
// Left, how you watch and hear (fullscreen, ambient light, volume); right, what you do with the
// capture (preview, screenshot, record, stream, settings).
import { Theme } from "../theme.slint";
import { Raised } from "surface.slint";
import { IconButton, Side } from "basics.slint";

// Mute toggle with a level slider that opens to its right while hovered.
export component VolumeButton inherits Rectangle {
    in-out property <float> volume: 0.7;
    in-out property <bool> muted;
    width: 44px;
    height: 44px;

    // Stays open while the pointer is on the button, the gap or the slider, and a moment after.
    property <bool> pointed: button.hovered || bridge.has-hover || slider-area.has-hover;
    property <bool> open;
    changed pointed => {
        if (self.pointed) {
            self.open = true;
        }
    }

    Timer {
        interval: 250ms;
        running: root.open && !root.pointed;
        triggered => { root.open = false; }
    }

    // Covers the gap between the button and the slider, so crossing it keeps the slider open.
    bridge := TouchArea {
        x: root.width;
        width: 10px;
    }

    button := IconButton {
        icon: root.muted || root.volume == 0 ? @image-url("../assets/icons/volume_mute.svg")
            : root.volume < 0.5 ? @image-url("../assets/icons/volume_low.svg")
            : @image-url("../assets/icons/volume_high.svg");
        clicked => { root.muted = !root.muted; }
    }

    Raised {
        fill: Theme.c.top;
        x: root.width + 10px;
        y: 0;
        width: 176px;
        height: 44px;
        opacity: root.open ? 1 : 0;
        visible: self.opacity > 0;
        animate opacity { duration: Theme.quick; }

        HorizontalLayout {
            padding-left: 14px;
            padding-right: 14px;
            spacing: 10px;

            track := Rectangle {
                height: 6px;
                y: (parent.height - self.height) / 2;
                border-radius: 3px;
                background: Theme.c.deep;

                Rectangle {
                    x: 0;
                    width: parent.width * (root.muted ? 0 : root.volume);
                    border-radius: 3px;
                    background: Theme.c.accent;
                }
            }

            Text {
                width: 34px;
                text: (root.muted ? 0 : Math.round(root.volume * 100)) + "%";
                color: Theme.c.text-muted;
                font-size: Theme.text-s;
                vertical-alignment: center;
                horizontal-alignment: right;
            }
        }

        slider-area := TouchArea {
            function set-from(x: length) {
                root.volume = max(0, min(1, (x - 14px) / track.width));
                root.muted = false;
            }
            pointer-event(event) => {
                if (event.kind == PointerEventKind.down) {
                    self.set-from(self.mouse-x);
                }
            }
            moved => {
                if (self.pressed) {
                    self.set-from(self.mouse-x);
                }
            }
        }
    }
}

component DockPanel inherits Raised {
    fill: Theme.c.panel;
    width: column.preferred-width;
    height: column.preferred-height;

    column := VerticalLayout {
        padding: 8px;
        spacing: 6px;
        @children
    }
}

// A larger gap between groups: depth and spacing separate things, not lines.
component Gap inherits Rectangle {
    height: 10px;
}

export component ViewDock inherits DockPanel {
    in property <bool> fullscreen;
    callback toggle-fullscreen();
    in-out property <bool> ambient-light;
    in-out property <float> volume: 0.7;
    in-out property <bool> muted;

    IconButton {
        icon: root.fullscreen ? @image-url("../assets/icons/fullscreen_exit.svg") : @image-url("../assets/icons/fullscreen.svg");
        tooltip: root.fullscreen ? "Exit fullscreen (F11)" : "Fullscreen (F11)";
        tooltip-side: Side.right;
        clicked => { root.toggle-fullscreen(); }
    }

    IconButton {
        icon: @image-url("../assets/icons/ambient_light.svg");
        tooltip: root.ambient-light ? "Turn off ambient light" : "Ambient light";
        tooltip-side: Side.right;
        active: root.ambient-light;
        clicked => { root.ambient-light = !root.ambient-light; }
    }

    Gap { }

    VolumeButton {
        volume <=> root.volume;
        muted <=> root.muted;
    }
}

export component ActionDock inherits DockPanel {
    in-out property <bool> preview-hidden;
    in-out property <bool> recording;
    in-out property <bool> live;
    callback screenshot();
    callback settings();

    IconButton {
        icon: root.preview-hidden ? @image-url("../assets/icons/preview_off.svg") : @image-url("../assets/icons/preview.svg");
        tooltip: root.preview-hidden ? "Show preview" : "Hide preview (recording continues)";
        tooltip-side: Side.left;
        active: root.preview-hidden;
        clicked => { root.preview-hidden = !root.preview-hidden; }
    }

    IconButton {
        icon: @image-url("../assets/icons/screenshot.svg");
        tooltip: "Screenshot (F9)";
        tooltip-side: Side.left;
        clicked => { root.screenshot(); }
    }

    IconButton {
        icon: root.recording ? @image-url("../assets/icons/record_stop.svg") : @image-url("../assets/icons/record.svg");
        tooltip: root.recording ? "Stop recording (F10)" : "Record (F10)";
        tooltip-side: Side.left;
        active: root.recording;
        primary: true;
        clicked => { root.recording = !root.recording; }
    }

    IconButton {
        icon: @image-url("../assets/icons/live.svg");
        tooltip: root.live ? "Stop streaming" : "Stream to friends";
        tooltip-side: Side.left;
        active: root.live;
        primary: true;
        clicked => { root.live = !root.live; }
    }

    Gap { }

    IconButton {
        icon: @image-url("../assets/icons/settings.svg");
        tooltip: "Settings";
        tooltip-side: Side.left;
        clicked => { root.settings(); }
    }
}
