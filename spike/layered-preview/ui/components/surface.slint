// Raised surface: a rounded fill over two hollow nine-slice shadows (research R14,
// tools/make_shadow.py). The images carry radius 16 and their offset: margins soft 36 + 10 below,
// tight 9 + 2 below. The fill may be semi-transparent: the shadows stay outside the shape.
import { Theme, Palette } from "../theme.slint";

export component Raised inherits Rectangle {
    in property <Palette> c: Theme.c;
    in property <brush> fill: c.raised;
    // Elevation 0 hides the shadows (a flat surface), 1 is the soft + tight pair.
    in property <float> elevation: 1;

    Image {
        x: -36px;
        y: -36px;
        width: parent.width + 72px;
        height: parent.height + 72px + 10px;
        source: @image-url("../assets/shadows/soft.png", nine-slice(52 52 62 52));
        opacity: root.c.shadow * root.elevation;
    }

    Image {
        x: -9px;
        y: -9px;
        width: parent.width + 18px;
        height: parent.height + 18px + 2px;
        source: @image-url("../assets/shadows/tight.png", nine-slice(25 25 27 25));
        opacity: root.c.shadow * root.elevation;
    }

    Rectangle {
        border-radius: Theme.radius-m;
        background: root.fill;
        @children
    }
}
