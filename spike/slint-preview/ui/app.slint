// Bare video window for path B (research R5). The visual directions come in T027–T032.
export component App inherits Window {
    in property <image> video-frame;
    in property <string> message;
    callback toggle-fullscreen();
    callback quit();

    title: "CapturaX spike";
    preferred-width: 1280px;
    preferred-height: 720px;
    background: #000000;
    forward-focus: keys;

    keys := FocusScope {
        key-pressed(event) => {
            if (event.text == Key.F11 || event.text == "f" || event.text == "F") {
                root.toggle-fullscreen();
                return accept;
            }
            if (event.text == Key.Escape || event.text == "q" || event.text == "Q") {
                root.quit();
                return accept;
            }
            reject
        }

        Image {
            width: parent.width;
            height: parent.height;
            source: root.video-frame;
            image-fit: contain;
        }

        if root.message != "": Text {
            text: root.message;
            color: #ffffffcc;
            font-size: 18px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}
