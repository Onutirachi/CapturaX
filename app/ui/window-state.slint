// The window's state, kept by Rust; the UI asks for changes through the callbacks. Ported from
// the stack spike (T037, T050).
export global WindowState {
    in property <bool> maximized;
    in property <bool> fullscreen;
    // The window has the keyboard focus.
    in property <bool> active: true;
    // The pointer is on the maximize button, or pressed it, while the system owns it for the snap
    // layouts flyout on Windows 11 (FR-011): the button sees no pointer of its own then.
    in property <bool> max-hover;
    in property <bool> max-pressed;
    callback minimize();
    callback toggle-maximize();
    callback close();
    callback toggle-fullscreen();
    // The title bar's drag area: start a system move.
    callback start-move();
}
