// The info bubbles for `slint-viewer` (not built into the app), over a video stand-in half white,
// half black, with stand-ins for the toolbar and the side docks. The first arrangement puts a
// bubble in each corner; the buttons switch to all four in one corner, toggle the controls (the
// pinned frame rate stays) and clear the values, so the slides show. Hover a bubble for its
// controls; their Pin toggle pins it here too (the menu and the tooltip need the app's top layer,
// so only the controls show here). Sample texts are plain strings: previews are left out of the translation
// check.
import { Theme } from "../theme.slint";
import { InfoBubbles, BubbleControlsLayer } from "../components/info-bubbles.slint";
import { NoticeBox } from "../components/notice.slint";
import "../assets/fonts/Inter.ttf";

component Stand inherits Rectangle {
    in property <NoticeBox> box;
    x: self.box.x;
    y: self.box.y;
    width: self.box.w;
    height: self.box.h;
    border-radius: 12px;
    background: #808080a0;
}

component Switch inherits Rectangle {
    in property <string> label;
    callback clicked();
    width: 150px;
    height: 32px;
    border-radius: 8px;
    background: area.has-hover ? #3060c0 : #2050a0;
    Text {
        text: root.label;
        color: white;
    }
    area := TouchArea {
        clicked => { root.clicked(); }
    }
}

export component InfoBubblesPreview inherits Window {
    title: "Info bubbles preview";
    default-font-family: Theme.font;
    preferred-width: 1000px;
    preferred-height: 560px;
    background: #000000;

    property <bool> spread: true;
    property <bool> controls: true;
    property <bool> values: true;
    property <[bool]> pinned: [false, false, true, false];
    property <NoticeBox> toolbar: { x: (root.width - 420px) / 2, y: 12px, w: 420px, h: 56px };
    property <NoticeBox> left-dock: { x: 12px, y: (root.height - 232px) / 2, w: 64px, h: 232px };
    property <NoticeBox> right-dock: { x: root.width - 76px, y: (root.height - 128px) / 2, w: 64px, h: 128px };

    // The video stand-in: white on the left, black on the right.
    Rectangle {
        width: parent.width / 2;
        x: 0;
        background: #ffffff;
    }

    if root.controls: Stand { box: root.toolbar; }
    if root.controls: Stand { box: root.left-dock; }
    if root.controls: Stand { box: root.right-dock; }

    InfoBubbles {
        width: parent.width;
        height: parent.height;
        controls-shown: root.controls;
        bubble-corner: root.spread ? [0, 1, 2, 3] : [3, 3, 3, 3];
        bubble-rank: root.spread ? [0, 0, 0, 0] : [0, 1, 2, 3];
        bubble-pinned: root.pinned;
        pin-toggled(kind) => {
            root.pinned = [
                kind == 0 ? !root.pinned[0] : root.pinned[0], kind == 1 ? !root.pinned[1] : root.pinned[1],
                kind == 2 ? !root.pinned[2] : root.pinned[2], kind == 3 ? !root.pinned[3] : root.pinned[3],
            ];
        }
        toolbar-box: root.toolbar;
        left-dock-box: root.left-dock;
        right-dock-box: root.right-dock;
        source: root.values ? "ezcap Live Gamer Ultra" : "";
        mode: root.values ? "1920 × 1080" : "";
        mode-tag: "Full HD";
        mode-tag-kind: "16:9";
        mode-aspect: "16:9";
        fps: root.values ? "111 / 120 FPS" : "";
        latency: root.values ? "3 ms + ~24 ms" : "";
    }

    VerticalLayout {
        x: (root.width - 150px) / 2;
        y: (root.height - self.preferred-height) / 2;
        spacing: 8px;
        Switch {
            label: root.spread ? "All bottom right" : "One per corner";
            clicked => { root.spread = !root.spread; }
        }
        Switch {
            label: root.controls ? "Hide controls" : "Show controls";
            clicked => { root.controls = !root.controls; }
        }
        Switch {
            label: root.values ? "Clear values" : "Give values";
            clicked => { root.values = !root.values; }
        }
    }

    BubbleControlsLayer {
        width: parent.width;
        height: parent.height;
    }
}
