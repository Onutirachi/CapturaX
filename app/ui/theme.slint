// Theme tokens (FR-016, research R8): one cool neutral hue in four tone steps, orange accent
// #FF7304 with dark ink on orange, Inter bundled with the app, depth by tone steps and shadow
// images, semi-transparent panels only (dock, title bar, overlay), opaque menus, buttons and
// icons, a 2 px focus ring as the only outline. Ported from the stack spike (T027).
import "assets/fonts/Inter.ttf";

export struct Palette {
    // Tone steps, from the deepest (window background, sunken wells) to the top (raised controls).
    deep: color,
    base: color,
    raised: color,
    top: color,
    // Hover and press tints laid over a surface.
    hover: color,
    press: color,
    text: color,
    text-muted: color,
    text-faint: color,
    accent: color,
    accent-hover: color,
    // Text and icons on the accent.
    accent-ink: color,
    // Accent as text, as the icon of a toggled tool or chosen category, and as the focus ring
    // (the light theme needs a deeper orange to read).
    accent-text: color,
    // The soft orange chip of a toggled tool or chosen category.
    accent-soft: color,
    ok: color,
    warn: color,
    bad: color,
    // Semi-transparent panels over the video (title bar, dock, overlay); only panels are
    // transparent.
    panel: color,
    // Dims the video behind the settings panel.
    scrim: color,
    // Shadow images are drawn at this opacity: light surfaces need softer shadows.
    shadow: float,
    // The black video background (F56): its ground and the state message tones on it, the same
    // in both themes.
    ground-black: color,
    on-black-text: color,
    on-black-muted: color,
    // Mode tags (F43, data-model.md "Mode"): one fill per aspect ratio family, Custom and the
    // aspect tag neutral; white text, the same in both themes.
    tag-1-1: color,
    tag-5-4: color,
    tag-11-9: color,
    tag-4-3: color,
    tag-3-2: color,
    tag-25-16: color,
    tag-16-10: color,
    tag-5-3: color,
    tag-16-9: color,
    tag-17-9: color,
    tag-21-9: color,
    tag-32-9: color,
    tag-custom: color,
    tag-aspect: color,
}

export global Palettes {
    out property <Palette> dark: {
        deep: #0e0f13,
        base: #16171c,
        raised: #1e1f25,
        top: #282a31,
        hover: #ffffff12,
        press: #ffffff1f,
        text: #f2f3f6,
        text-muted: #a8abb5,
        text-faint: #90939f,
        accent: #ff7304,
        accent-hover: #ff8a2e,
        accent-ink: #16171c,
        accent-text: #ff7304,
        accent-soft: #ff73042e,
        ok: #3fcf7c,
        warn: #f2c14e,
        bad: #f46a62,
        panel: #0e0f13b8,
        scrim: #00000080,
        shadow: 1,
        ground-black: #000000,
        on-black-text: #f2f3f6,
        on-black-muted: #a8abb5,
        tag-1-1: #9c3d2e,
        tag-5-4: #8f6a00,
        tag-11-9: #6b4f3a,
        tag-4-3: #5d6b25,
        tag-3-2: #0f7a6e,
        tag-25-16: #4b5f8a,
        tag-16-10: #756f92,
        tag-5-3: #c2410c,
        tag-16-9: #6d6bbb,
        tag-17-9: #2f7d32,
        tag-21-9: #be185d,
        tag-32-9: #7e3fbf,
        tag-custom: #62666f,
        tag-aspect: #4a4d55,
    };
    out property <Palette> light: {
        deep: #dfe1e7,
        base: #eceef2,
        raised: #f7f8fa,
        top: #ffffff,
        hover: #0000000d,
        press: #00000017,
        text: #1c1e25,
        text-muted: #474b57,
        text-faint: #60646f,
        accent: #f26a00,
        accent-hover: #ff7304,
        accent-ink: #16171c,
        accent-text: #9e4500,
        accent-soft: #f26a0024,
        ok: #0f7038,
        warn: #7d5a00,
        bad: #b42a23,
        panel: #f7f8fac4,
        scrim: #00000052,
        shadow: 0.35,
        ground-black: #000000,
        on-black-text: #f2f3f6,
        on-black-muted: #a8abb5,
        tag-1-1: #9c3d2e,
        tag-5-4: #8f6a00,
        tag-11-9: #6b4f3a,
        tag-4-3: #5d6b25,
        tag-3-2: #0f7a6e,
        tag-25-16: #4b5f8a,
        tag-16-10: #756f92,
        tag-5-3: #c2410c,
        tag-16-9: #6d6bbb,
        tag-17-9: #2f7d32,
        tag-21-9: #be185d,
        tag-32-9: #7e3fbf,
        tag-custom: #62666f,
        tag-aspect: #4a4d55,
    };
}

export global Theme {
    // Set from Rust: the resolved theme (Automatic follows the system).
    in property <bool> dark: true;
    out property <Palette> c: dark ? Palettes.dark : Palettes.light;

    // A raised surface of this logical size at the window's scale: its fill over its shadow at
    // `shadow` strength, made in Rust in physical pixels so it is drawn 1:1 (research R8). Empty
    // in the preview.
    pure callback surface(width: length, height: length, scale: float, fill: color, shadow: float) -> image;

    out property <string> font: "Inter";
    out property <length> text-s: 12px;
    out property <length> text-m: 14px;
    out property <length> text-l: 18px;
    out property <length> text-xl: 26px;

    out property <length> radius-s: 10px;
    out property <length> radius-m: 16px;
    out property <length> radius-l: 22px;
    out property <length> gap-s: 6px;
    out property <length> gap-m: 12px;
    out property <length> gap-l: 20px;
    out property <length> gap-xl: 24px;

    out property <length> focus-ring: 2px;
    out property <duration> quick: 160ms;
}
