// Square icon control, ported from the stack spike's `basics.slint`. `active` marks a toggled
// state; with `primary` it fills with the accent (recording, live). The tooltip shows after 500 ms
// of hover, or at once on keyboard focus, in the top layer. Disabled, it fades, ignores clicks and
// leaves the focus order; its tooltip still shows on hover (screenshot US2 scenario 2). Enter or Space activates it (FR-020). An empty tooltip hides the one
// shown. With `takes-wheel` the mouse wheel over it calls `wheel`; a right press calls
// `right-pressed`. With `takes-hold` a press held 500 ms calls `held` instead of `clicked`. Keys
// other than Enter and Space go to `key`.
import { Theme } from "../theme.slint";
import { FocusRing } from "focus-ring.slint";
import { Tooltips, Side } from "tooltip.slint";

export component IconButton inherits Rectangle {
    in property <image> icon;
    in property <string> tooltip;
    // The name screen readers say; the tooltip by default.
    in property <string> label: root.tooltip;
    in property <bool> active;
    in property <bool> primary;
    in property <length> size: 44px;
    in property <length> icon-size: 22px;
    // The icon's color when not toggled.
    in property <brush> icon-color: Theme.c.text;
    in property <bool> enabled: true;
    // False keeps it out of the focus order without fading it (the docks under the settings panel).
    in property <bool> focusable: true;
    // Where the tooltip prefers to open: towards the inside of the window.
    in property <Side> tooltip-side: Side.top;
    out property <bool> hovered: area.has-hover;
    out property <bool> has-focus: focus.has-focus;
    in property <bool> takes-wheel;
    in property <bool> takes-hold;
    callback clicked();
    // A press held 500 ms (with `takes-hold`); the release then clicks nothing.
    callback held();
    // A key the button does not use itself; `reject` passes it on.
    callback key(KeyEvent) -> EventResult;
    callback right-pressed();
    // The wheel's vertical move in logical pixels, positive away from the user (60 per notch).
    callback wheel(length);

    // The token of the tooltip this button shows, 0 when none.
    property <int> tip;
    // Its tooltip still shows: a size change or another control's tooltip hides it without telling.
    property <bool> tip-shown: root.tip > 0 && root.tip == Tooltips.owner;
    // The press in progress was held: its release clicks nothing.
    property <bool> was-held;
    property <bool> wants-tip: (area.has-hover || focus.has-focus) && root.visible;

    width: root.size;
    height: root.size;
    border-radius: Theme.radius-m;
    // A toggled tool sits on an opaque chip: on a semi-transparent panel the video behind would
    // change the icon's contrast (the soft accent tint is laid over it below).
    background: root.active && root.primary ? (area.has-hover ? Theme.c.accent-hover : Theme.c.accent)
        : root.active ? Theme.c.raised
        : transparent;
    animate background { duration: Theme.quick; }
    opacity: root.enabled ? 1 : 0.35;

    accessible-role: button;
    accessible-label: root.label;
    accessible-enabled: root.enabled;
    accessible-action-default => { root.activate(); }

    forward-focus: focus;

    function activate() {
        if (root.enabled) {
            // Hidden until the pointer leaves and comes back (-1 stops the timer).
            Tooltips.hide(root.tip);
            root.tip = -1;
            root.clicked();
        }
    }

    function show-tip() {
        if (root.tooltip != "") {
            root.tip = Tooltips.show(root.tooltip, root.tooltip-side,
                root.absolute-position.x, root.absolute-position.y, root.width, root.height);
        } else {
            root.hide-tip();
        }
    }

    function hide-tip() {
        Tooltips.hide(root.tip);
        root.tip = 0;
    }

    // A language switch changes the text of a tooltip that shows (FR-024).
    changed tooltip => {
        if (root.tip-shown) {
            root.show-tip();
        }
    }

    changed wants-tip => {
        if (!self.wants-tip) {
            root.hide-tip();
        } else if (focus.has-focus && !area.has-hover) {
            root.show-tip();
        }
    }

    // The soft accent of a toggled tool, over its chip.
    Rectangle {
        border-radius: root.border-radius;
        background: root.active && !root.primary ? Theme.c.accent-soft : transparent;
        animate background { duration: Theme.quick; }
    }

    // Hover and press tint over the fill, also on a toggled tool (a primary one lightens instead).
    Rectangle {
        border-radius: root.border-radius;
        background: root.active && root.primary ? transparent
            : !root.enabled ? transparent
            : area.pressed ? Theme.c.press
            : area.has-hover ? Theme.c.hover
            : transparent;
        animate background { duration: Theme.quick; }
    }

    Image {
        source: root.icon;
        width: root.icon-size;
        height: root.icon-size;
        // A toggled tool shows its state in the icon color.
        colorize: root.active && root.primary ? Theme.c.accent-ink
            : root.active ? Theme.c.accent-text
            : root.icon-color;
    }

    // Enabled also while the button is not, so the hover still shows the tooltip; `activate`
    // ignores the click.
    area := TouchArea {
        clicked => {
            if (!root.was-held) {
                root.activate();
            }
        }
        pointer-event(event) => {
            if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                root.was-held = false;
            }
            if (root.enabled && event.button == PointerEventButton.right && event.kind == PointerEventKind.down) {
                root.right-pressed();
            }
        }
        scroll-event(event) => {
            if (!root.enabled || !root.takes-wheel || event.delta-y == 0) {
                return reject;
            }
            root.wheel(event.delta-y);
            accept
        }
    }

    focus := FocusScope {
        enabled: root.enabled && root.focusable;
        // A click does not take the focus: the ring and the tooltip stay with the keyboard.
        focus-on-click: false;
        key-pressed(event) => {
            if (event.text == Key.Return || event.text == Key.Space) {
                root.activate();
                return accept;
            }
            root.key(event)
        }
    }

    Timer {
        interval: 500ms;
        running: root.takes-hold && root.enabled && area.pressed && !root.was-held;
        triggered => {
            root.was-held = true;
            root.held();
        }
    }

    Timer {
        interval: 500ms;
        running: area.has-hover && root.tip != -1 && !root.tip-shown && root.wants-tip && root.tooltip != "";
        triggered => { root.show-tip(); }
    }

    FocusRing {
        focused: focus.has-focus;
        radius: root.border-radius;
    }
}
