// The app's notices (FR-027, FR-033, research R15 "In-app balloon"): balloons of the info
// bubbles' family with the theme's raised fill and shadow, in the corner the Notification position
// setting picks. main.slint places them and stacks them; Rust keeps the settings notices' queue
// and shows each id at most once per run (app/src/notices.rs).
import { Theme } from "../theme.slint";
import { Raised } from "raised.slint";
import { ActionButton } from "action-button.slint";
import { IconButton } from "icon-button.slint";
import { Input } from "focus-ring.slint";

export enum NoticeKind { info, warning }

// A rectangle the notice balloons keep clear of, or a balloon's own (main.slint).
export struct NoticeBox { x: length, y: length, w: length, h: length }

// A settings notice (FR-033): the kind's icon, the title in bold, then the text (which may name a
// folder or a file) on as many lines as it needs, and ×. At most 480 px wide and the room the
// owner gives it. No timeout: it stays until closed, which tells Rust to show the next one. It
// grows in from its corner and leaves the same way, keeping its text while it leaves.
export component SettingsNotice inherits Rectangle {
    in property <bool> shown;
    in property <NoticeKind> kind: NoticeKind.info;
    in property <string> title;
    in property <string> text;
    // The widest it may be besides its own 480 px.
    in property <length> room;
    // The corner it grows from.
    in property <bool> top;
    in property <bool> left;
    // False keeps it out of the focus order (behind the settings panel).
    in property <bool> focusable: true;
    // 0 gone, 1 shown.
    out property <float> appear: root.shown ? 1 : 0;
    animate appear { duration: Theme.quick; easing: ease-out; }
    out property <bool> present: root.shown || root.appear > 0;
    callback dismiss();

    // Padding as in the device notice: 12 px before the icon, 6 px after ×, 10 px above and below.
    property <length> pad-left: 12px;
    property <length> pad-right: 6px;
    property <length> pad-y: 10px;
    property <length> icon-size: 20px;
    property <length> spacing: 8px;
    property <length> close-size: 32px;
    property <length> text-x: root.pad-left + root.icon-size + root.spacing;
    // The text's column, from after the icon to before ×.
    property <length> text-room: root.width - root.text-x - root.spacing - root.close-size - root.pad-right;

    visible: root.present;
    width: min(480px, root.room,
        root.text-x + max(title-measure.preferred-width, text-measure.preferred-width) + root.spacing + root.close-size + root.pad-right);
    height: max(44px, root.pad-y + title.height + text.height + root.pad-y);
    opacity: root.appear;
    transform-origin: { x: root.left ? 0 : self.width, y: root.top ? 0 : self.height };
    transform-scale: 0.92 + 0.08 * root.appear;

    accessible-role: AccessibleRole.text;
    accessible-label: root.title;
    accessible-description: root.text;

    // The texts' widths on one line each, to fit a short notice.
    title-measure := Text {
        visible: false;
        text: root.title;
        font-size: Theme.text-m;
        font-weight: 600;
    }

    text-measure := Text {
        visible: false;
        text: root.text;
        font-size: Theme.text-m;
    }

    Raised {
        width: root.width;
        height: root.height;
        radius: Theme.radius-m;
    }

    Image {
        x: root.pad-left;
        y: root.pad-y + (title.height - self.height) / 2;
        width: root.icon-size;
        height: root.icon-size;
        source: root.kind == NoticeKind.warning
            ? @image-url("../assets/icons/alert_triangle.svg")
            : @image-url("../assets/icons/info_circle.svg");
        colorize: root.kind == NoticeKind.warning ? Theme.c.warn : Theme.c.accent-text;
        accessible-role: none;
    }

    title := Text {
        x: root.text-x;
        y: root.pad-y;
        width: root.text-room;
        text: root.title;
        color: Theme.c.text;
        font-size: Theme.text-m;
        font-weight: 600;
        wrap: word-wrap;
        accessible-role: none;
    }

    text := Text {
        x: root.text-x;
        y: title.y + title.height;
        width: root.text-room;
        text: root.text;
        color: Theme.c.text;
        font-size: Theme.text-m;
        wrap: word-wrap;
        accessible-role: none;
    }

    IconButton {
        x: root.width - root.pad-right - self.width;
        y: root.pad-y + (title.height - self.height) / 2;
        size: root.close-size;
        icon-size: 18px;
        border-radius: Theme.radius-s;
        icon: @image-url("../assets/icons/close.svg");
        icon-color: Theme.c.text-muted;
        tooltip: @tr("Dismiss");
        focusable: root.focusable && root.shown;
        enabled: root.shown;
        clicked => { root.dismiss(); }
    }
}

// The device notice balloon (FR-027, research R15 "In-app balloon"): one line in the info bubbles'
// shape (44 px, 16 px corners, 14 px text) with the theme's raised fill and shadow, so it reads over
// any video and is not taken for a bubble. The plug icon, the text Rust gives ("C920 connected"),
// **Open** when the device did not open by itself, and ×. It grows in from its corner, stays about
// 5 s (paused while the pointer or the keyboard is on it) and leaves the same way; a click anywhere
// on it closes it. Only the latest message: a new one replaces the text and starts the time again.
// The owner places it (main.slint) and gives it the room it may take.
export component DeviceNotice inherits Rectangle {
    // `connected`, `reconnected` or `disconnected`.
    in property <string> kind;
    in property <string> text;
    in property <bool> can-open;
    // Changes for each new notice, which shows it.
    in property <int> serial;
    // The widest it may be; a longer text is cut with an ellipsis.
    in property <length> room;
    // The corner it grows from.
    in property <bool> top;
    in property <bool> left;
    // False keeps it out of the focus order (behind the settings panel).
    in property <bool> focusable: true;
    // 0 gone, 1 shown: the owner slides its neighbours by it.
    out property <float> appear: root.showing ? 1 : 0;
    animate appear { duration: Theme.quick; easing: ease-out; }
    out property <bool> present: root.showing || root.appear > 0;
    callback open();

    property <bool> showing;
    // The time left before it leaves.
    property <duration> left-time;
    property <bool> open-focused;
    property <bool> held: area.has-hover || ((root.open-focused || close-button.has-focus) && Input.keyboard);

    changed serial => {
        self.showing = true;
        self.left-time = 5s;
    }

    function close() {
        root.showing = false;
    }

    // Counts down while not held, so the pointer pauses it.
    Timer {
        interval: 100ms;
        running: root.showing && !root.held;
        triggered => {
            root.left-time -= 100ms;
            if (root.left-time <= 0) {
                root.close();
            }
        }
    }

    visible: root.present;
    width: min(row.preferred-width, root.room);
    height: 44px;
    opacity: root.appear;
    transform-origin: { x: root.left ? 0 : self.width, y: root.top ? 0 : self.height };
    transform-scale: 0.92 + 0.08 * root.appear;

    accessible-role: AccessibleRole.text;
    accessible-label: root.text;

    Raised {
        width: root.width;
        height: root.height;
        radius: Theme.radius-m;
    }

    // A click anywhere closes it; its buttons sit above.
    area := TouchArea {
        enabled: root.showing;
        clicked => { root.close(); }
    }

    row := HorizontalLayout {
        padding-left: 12px;
        padding-right: 6px;
        spacing: 8px;
        alignment: start;

        VerticalLayout {
            alignment: center;
            Image {
                width: 20px;
                height: 20px;
                source: root.kind == "disconnected" ? @image-url("../assets/icons/plug_connected_x.svg")
                    : @image-url("../assets/icons/plug_connected.svg");
                colorize: root.kind == "disconnected" ? Theme.c.text-muted : Theme.c.ok;
                accessible-role: none;
            }
        }

        Text {
            text: root.text;
            color: Theme.c.text;
            font-size: Theme.text-m;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
            accessible-role: none;
        }

        if root.can-open: VerticalLayout {
            alignment: center;
            padding-left: 4px;
            ActionButton {
                label: @tr("Open");
                primary: true;
                height: 32px;
                min-width: 0;
                pad: 14px;
                focusable: root.focusable && root.showing;
                changed has-focus => { root.open-focused = self.has-focus; }
                clicked => {
                    root.open();
                    root.close();
                }
            }
        }

        VerticalLayout {
            alignment: center;
            close-button := IconButton {
                size: 32px;
                icon-size: 18px;
                border-radius: Theme.radius-s;
                icon: @image-url("../assets/icons/close.svg");
                icon-color: Theme.c.text-muted;
                tooltip: @tr("Dismiss");
                focusable: root.focusable && root.showing;
                clicked => { root.close(); }
            }
        }
    }
}
