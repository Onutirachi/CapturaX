// The header every small window inside the main window shares (settings panel, notices): an
// icon and a title on the left, the close control at the other end.
import { Theme } from "../theme.slint";
import { IconButton } from "icon-button.slint";
import { Side } from "tooltip.slint";

export component PanelHeader inherits Rectangle {
    in property <image> icon;
    in property <brush> icon-color: Theme.c.text;
    in property <string> title;
    in property <string> close-tooltip;
    // Left padding of the icon; the owner aligns its content with it.
    in property <length> pad: Theme.gap-l;
    callback close();

    // Where the title starts, for content aligned under it.
    out property <length> title-x: root.pad + root.icon-size + Theme.gap-m;

    property <length> icon-size: 20px;

    height: 52px;

    Image {
        x: root.pad;
        y: (parent.height - self.height) / 2;
        width: root.icon-size;
        height: root.icon-size;
        source: root.icon;
        colorize: root.icon-color;
    }

    Text {
        x: root.title-x;
        width: close.x - self.x - Theme.gap-s;
        height: parent.height;
        text: root.title;
        color: Theme.c.text;
        font-size: Theme.text-l;
        font-weight: 600;
        vertical-alignment: center;
        overflow: elide;
    }

    close := IconButton {
        x: root.width - self.width - Theme.gap-s;
        y: (root.height - self.height) / 2;
        size: 36px;
        icon-size: 18px;
        icon: @image-url("../assets/icons/close.svg");
        tooltip: root.close-tooltip;
        tooltip-side: Side.bottom;
        clicked => { root.close(); }
    }
}
