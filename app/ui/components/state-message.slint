// The one component for empty and error states (FR-033): an icon, a short title, an optional
// one-line detail and zero, one or two actions (primary and secondary), centered in the area it
// fills (the video area). It has no fill: the video background and its watermark show behind it
// (device preview FR-029), the theme's deepest tone or black (`on-black`). An
// action reports its id; Rust decides what it does. Enter or Space activates the focused action
// (FR-020).
import { Theme } from "../theme.slint";
import { ActionButton } from "action-button.slint";

// One action: the id sent to Rust and the label shown. An empty id means no action.
export struct StateAction {
    id: string,
    label: string,
}

export component StateMessage inherits Rectangle {
    in property <image> icon;
    in property <string> title;
    // One line; longer text is cut with an ellipsis.
    in property <string> detail;
    in property <StateAction> primary;
    in property <StateAction> secondary;
    // The black video background is behind it: light tones in both themes.
    in property <bool> on-black;
    callback action(string /* action id */);

    VerticalLayout {
        alignment: center;
        padding: Theme.gap-xl;
        spacing: Theme.gap-m;

        Image {
            source: root.icon;
            height: 48px;
            image-fit: contain;
            colorize: root.on-black ? Theme.c.on-black-muted : Theme.c.text-muted;
            accessible-role: none;
        }

        Text {
            text: root.title;
            color: root.on-black ? Theme.c.on-black-text : Theme.c.text;
            font-size: Theme.text-l;
            font-weight: 600;
            horizontal-alignment: center;
            wrap: word-wrap;
        }

        if root.detail != "": Text {
            text: root.detail;
            color: root.on-black ? Theme.c.on-black-muted : Theme.c.text-muted;
            font-size: Theme.text-m;
            horizontal-alignment: center;
            overflow: elide;
        }

        if root.primary.id != "" || root.secondary.id != "": HorizontalLayout {
            alignment: center;
            spacing: Theme.gap-m;
            padding-top: Theme.gap-s;

            if root.primary.id != "": ActionButton {
                label: root.primary.label;
                primary: true;
                clicked => { root.action(root.primary.id); }
            }

            if root.secondary.id != "": ActionButton {
                label: root.secondary.label;
                clicked => { root.action(root.secondary.id); }
            }
        }
    }
}
