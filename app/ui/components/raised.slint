// Raised surface: a rounded opaque fill over two hollow nine-slice shadows (research R8). The
// images come from Rust (app/src/shadows.rs) at radius 16 with their margins: soft 36 and 10 more
// below, tight 9 and 2 more below. Ported from the stack spike's `surface.slint`.
import { Theme } from "../theme.slint";

export component Raised inherits Rectangle {
    in property <brush> fill: Theme.c.raised;

    Image {
        x: -36px;
        y: -36px;
        width: parent.width + 72px;
        height: parent.height + 72px + 10px;
        source: Theme.shadow-soft;
        opacity: Theme.c.shadow;
    }

    Image {
        x: -9px;
        y: -9px;
        width: parent.width + 18px;
        height: parent.height + 18px + 2px;
        source: Theme.shadow-tight;
        opacity: Theme.c.shadow;
    }

    Rectangle {
        border-radius: Theme.radius-m;
        background: root.fill;
        @children
    }
}
