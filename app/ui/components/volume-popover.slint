// The volume button of the left dock and its popover (preview audio FR-011, research R12): the
// preview's own level and mute, never the system's. The button's icon shows the level (set by Rust
// from `audio::volume::icon`); the popover shows a 0–100 slider with its value and takes no focus:
// the button alone does mute and level, so Tab stops once.
// Mouse: a click toggles mute; resting 300 ms on the button opens the popover, which stays while
// the pointer is on the button or the popover and closes 400 ms after it leaves both; a right
// press opens it; the wheel over the button changes the level without opening it. Touch: a tap
// opens it, a tap outside closes it, holding the button 500 ms toggles mute. Keyboard: the focus
// on the button opens it, Enter or Space toggles mute, the arrows move the level ±5, Home and End
// to 0 and 100, and it closes when the focus leaves the button.
// The popover is a child of the button, so it follows it in the chrome's slide; it stands beside
// the dock, inside the chrome.
import { Theme } from "../theme.slint";
import { Raised } from "raised.slint";
import { IconButton } from "icon-button.slint";
import { Side } from "tooltip.slint";
import { Input } from "focus-ring.slint";

// A horizontal 0–100 slider: press or drag on it. `moved` reports each value the user sets, also
// the same one (a press while muted unmutes). It takes no focus: the volume button's keys move it.
component VolumeSlider inherits Rectangle {
    in property <int> value;
    // Drawn without the accent while the sound is muted.
    in property <bool> muted;
    in property <string> label;
    out property <bool> dragging: area.pressed;
    callback moved(int);

    property <length> knob: 16px;
    property <length> travel: root.width - root.knob;

    height: 28px;

    accessible-role: slider;
    accessible-label: root.label;
    accessible-value: root.value;
    accessible-value-minimum: 0;
    accessible-value-maximum: 100;
    accessible-value-step: 5;
    accessible-action-increment => { root.set(root.value + 5); }
    accessible-action-decrement => { root.set(root.value - 5); }

    function set(value: int) {
        root.moved(clamp(value, 0, 100));
    }

    function pick(x: length) {
        root.set(round((x - root.knob / 2) / max(1px, root.travel) * 100));
    }

    // The track, then its filled part up to the knob.
    Rectangle {
        x: root.knob / 2;
        y: (root.height - self.height) / 2;
        width: root.travel;
        height: 4px;
        border-radius: 2px;
        background: Theme.c.text-faint;
    }

    Rectangle {
        x: root.knob / 2;
        y: (root.height - self.height) / 2;
        width: root.travel * root.value / 100;
        height: 4px;
        border-radius: 2px;
        background: root.muted ? Theme.c.text-muted : Theme.c.accent;
    }

    Rectangle {
        x: root.travel * root.value / 100;
        y: (root.height - self.height) / 2;
        width: root.knob;
        height: root.knob;
        border-radius: root.knob / 2;
        background: root.muted ? Theme.c.text-muted : area.has-hover || area.pressed ? Theme.c.accent-hover : Theme.c.accent;
        animate background { duration: Theme.quick; }
    }

    area := TouchArea {
        pointer-event(event) => {
            if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                root.pick(self.mouse-x);
            }
        }
        moved => {
            if (self.pressed) {
                root.pick(self.mouse-x);
            }
        }
    }
}

export component VolumeButton inherits Rectangle {
    in property <length> size: 44px;
    // False keeps the button out of the focus order (under the settings panel).
    in property <bool> focusable: true;
    // The chrome shows and takes input; when it hides the popover closes.
    in property <bool> active: true;
    // The window's size, for the area a tap outside the popover closes it in.
    in property <length> window-width;
    in property <length> window-height;
    in-out property <int> volume: 80;
    in-out property <bool> muted;
    // `audio::volume::icon` of the level: "off", "low", "medium" or "high".
    in property <string> level-icon: "high";
    out property <bool> open;
    out property <bool> has-focus: button.has-focus;
    // The user set the level or the mute.
    callback volume-changed(int, bool);
    // The wheel's vertical move over the button, in logical pixels (60 per notch, up is positive).
    callback wheel(length);

    // Opened by a tap: it stays until a tap outside it.
    property <bool> pinned;
    property <bool> focused: button.has-focus && Input.keyboard;
    property <bool> keep: button.hovered || (root.open && (panel-area.has-hover || slider.dragging))
        || root.focused || root.pinned;

    width: root.size;
    height: root.size;

    public function close() {
        root.open = false;
        root.pinned = false;
    }

    function set(volume: int, muted: bool) {
        if (volume != root.volume || muted != root.muted) {
            root.volume = volume;
            root.muted = muted;
            root.volume-changed(volume, muted);
        }
    }

    // A level the user sets plays: moving it unmutes.
    function level(volume: int) {
        root.set(clamp(volume, 0, 100), false);
    }

    changed active => {
        if (!self.active) {
            root.close();
        }
    }
    changed focused => {
        if (self.focused && root.active) {
            root.open = true;
        }
    }

    button := IconButton {
        size: root.size;
        icon: root.level-icon == "off" ? @image-url("../assets/icons/volume_off.svg")
            : root.level-icon == "low" ? @image-url("../assets/icons/volume_1.svg")
            : root.level-icon == "medium" ? @image-url("../assets/icons/volume_2.svg")
            : @image-url("../assets/icons/volume.svg");
        // The popover shows the level itself.
        tooltip: root.open ? "" : root.muted ? @tr("Muted") : @tr("Volume {}%", root.volume);
        label: root.muted ? @tr("Muted") : @tr("Volume {}%", root.volume);
        tooltip-side: Side.right;
        active: root.open;
        focusable: root.focusable;
        takes-wheel: true;
        takes-hold: Input.touch;
        clicked => {
            if (Input.touch) {
                root.open = true;
                root.pinned = true;
            } else {
                root.set(root.volume, !root.muted);
            }
        }
        held => { root.set(root.volume, !root.muted); }
        right-pressed => { root.open = true; }
        wheel(delta) => { root.wheel(delta); }
        key(event) => {
            if (event.text == Key.RightArrow || event.text == Key.UpArrow) {
                root.level(root.volume + 5);
                return accept;
            }
            if (event.text == Key.LeftArrow || event.text == Key.DownArrow) {
                root.level(root.volume - 5);
                return accept;
            }
            if (event.text == Key.Home) {
                root.level(0);
                return accept;
            }
            if (event.text == Key.End) {
                root.level(100);
                return accept;
            }
            reject
        }
    }

    // Opens after a short rest, so sweeping the pointer along the dock opens nothing.
    Timer {
        interval: 300ms;
        running: !root.open && root.active && button.hovered && !Input.touch;
        triggered => { root.open = true; }
    }

    Timer {
        interval: 400ms;
        running: root.open && !root.keep;
        triggered => { root.close(); }
    }

    // A tap anywhere else closes a popover a tap opened (the button too, as it lies under this).
    if root.pinned: TouchArea {
        x: -root.absolute-position.x;
        y: -root.absolute-position.y;
        width: root.window-width;
        height: root.window-height;
        clicked => { root.close(); }
    }

    // The popover and the gap between it and the button, so crossing the gap keeps it.
    panel-area := TouchArea {
        // Past the dock's 8 px padding, then 8 px clear of the dock.
        property <length> gap: 16px;
        x: root.width;
        y: (root.height - panel.height) / 2;
        width: self.gap + panel.width;
        height: panel.height;
        visible: root.open;
        enabled: root.open;

        property <float> appear: root.open ? 1 : 0;
        animate appear { duration: Theme.quick; easing: ease-out; }

        panel := Raised {
            fill: Theme.c.top;
            x: panel-area.gap;
            width: 240px;
            height: row.preferred-height;
            opacity: panel-area.appear;

            row := HorizontalLayout {
                padding: Theme.gap-m;
                spacing: 10px;

                VerticalLayout {
                    alignment: center;
                    horizontal-stretch: 1;

                    slider := VolumeSlider {
                        value: root.volume;
                        muted: root.muted;
                        label: @tr("Preview volume");
                        moved(value) => { root.level(value); }
                    }
                }

                Text {
                    width: 48px;
                    text: root.muted ? @tr("Muted") : @tr("{}%", root.volume);
                    color: Theme.c.text-muted;
                    font-size: Theme.text-m;
                    horizontal-alignment: right;
                    vertical-alignment: center;
                }
            }
        }
    }
}
