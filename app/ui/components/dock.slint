// A dock: a semi-transparent rounded panel holding icon buttons in a column, ported from the stack
// spike's `dock.slint`. The left dock holds the adjustments (fullscreen and settings in this spec)
// and the right dock the features, not shown until a later spec adds the first (FR-002a, app shell
// FR-015).
import { Theme } from "../theme.slint";
import { Raised } from "raised.slint";

export component Dock inherits Raised {
    fill: Theme.c.panel;
    radius: Theme.radius-dock;
    width: column.preferred-width;
    height: column.preferred-height;

    column := VerticalLayout {
        padding: 8px;
        spacing: 6px;
        @children
    }
}
