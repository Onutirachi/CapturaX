// The settings panel (FR-025, look FR-034): a raised panel centered over the dimmed video, opened
// from the dock's settings button and closed with Esc, its close control or a click outside it;
// the video keeps playing behind it. A column on the base tone runs its full height with the
// settings icon and "Settings" at its top, then the categories with their icons; the chosen
// one's rows fill the rest, the close control at its top right. In the compact layout the column
// keeps only the icons, names in tooltips. Each change is reported to Rust, which saves it at
// once (FR-029). The values live in the global `Prefs`, set by Rust.
import { Theme } from "../theme.slint";
import { Texts } from "../texts.slint";
import { Toggle } from "toggle.slint";
import { Tooltips, Side } from "tooltip.slint";
import { Raised } from "raised.slint";
import { IconButton } from "icon-button.slint";
import { FocusRing, Input } from "focus-ring.slint";
import { Select } from "select.slint";
import { MenuItem } from "menu.slint";
import { Segmented } from "segmented.slint";

export global Prefs {
    in-out property <bool> start-fullscreen;
    in-out property <bool> keep-in-tray;
    in-out property <bool> start-with-system;
    // Keep in tray shows only where the desktop has a tray (FR-014a).
    in property <bool> tray-available: true;
    in property <string> version;
    // Automatic, then each language's name in itself (FR-024), built by Rust from its list, so a
    // new language needs no change here.
    in property <[MenuItem]> languages;
    // The chosen entries: of `languages`, and of Automatic, Dark, Light.
    in-out property <int> language;
    in-out property <int> theme;
    // The corner the in-app notices show in (FR-032), in the grid's order: 0 top left, 1 top
    // right, 2 bottom left (the default), 3 bottom right.
    in-out property <int> notification-position: 2;
    callback notification-position-changed(int);
    // Preview (F56–F58): the video background (0 Theme, 1 Black), the watermark, and the video
    // shadow (0 Always, 1 With ambient light, 2 Off).
    in-out property <int> background;
    in-out property <bool> watermark: true;
    in-out property <int> shadow: 0;
    callback background-changed(int);
    callback watermark-changed(bool);
    callback shadow-changed(int);
    callback start-fullscreen-changed(bool);
    callback keep-in-tray-changed(bool);
    callback start-with-system-changed(bool);
    callback language-changed(int);
    callback theme-changed(int);
    // The panel opened: Rust reads the system's autostart entry again (FR-014b).
    callback opened();
}

// Later specs add their categories here (F40), with their names in `CategoryItem`.
enum Category { general, appearance, preview, about }

// No text here: a translated name in the list would make a language switch build the items
// again, losing the keyboard focus and leaving a shown tooltip in the old language.
struct CategoryEntry {
    id: Category,
    icon: image,
}

// One category in the column: its icon and name, tinted with the soft accent while chosen, as a
// toggled tool button (the dock's settings button). Compact, only the icon, with the name in a
// tooltip (after 500 ms of hover, or at once on keyboard focus). A click, Enter or Space chooses
// it.
component CategoryItem inherits Rectangle {
    in property <Category> id;
    in property <image> icon;
    in property <bool> selected;
    in property <bool> compact;
    callback chosen();

    // Created with the panel or when the layout switches: the chosen category takes the focus, so
    // the keyboard starts inside the panel (the ring shows only after a key).
    init => {
        if (root.selected) {
            focus.focus();
        }
    }

    property <string> text: root.id == Category.general ? @tr("General")
        : root.id == Category.appearance ? @tr("Appearance")
        : root.id == Category.preview ? @tr("Preview")
        : @tr("About");

    // The token of the tooltip shown, 0 when none.
    property <int> tip;
    // Its tooltip still shows: a size change or another control's tooltip hides it without telling.
    property <bool> tip-shown: root.tip > 0 && root.tip == Tooltips.owner;
    property <bool> wants-tip: root.compact && (area.has-hover || (focus.has-focus && Input.keyboard));
    property <color> ink: root.selected ? Theme.c.accent-text : area.has-hover ? Theme.c.text : Theme.c.text-muted;

    height: 44px;
    border-radius: 12px;
    background: root.selected ? Theme.c.accent-soft : area.has-hover ? Theme.c.hover : transparent;
    animate background { duration: Theme.quick; }

    accessible-role: AccessibleRole.tab;
    accessible-label: root.text;
    accessible-item-selectable: true;
    accessible-item-selected: root.selected;
    accessible-action-default => { root.chosen(); }

    forward-focus: focus;

    function show-tip() {
        root.tip = Tooltips.show(root.text, Side.right,
            root.absolute-position.x, root.absolute-position.y, root.width, root.height);
    }

    // A language switch changes the text of a tooltip that shows (FR-024).
    changed text => {
        if (root.tip-shown) {
            root.show-tip();
        }
    }

    changed wants-tip => {
        if (!self.wants-tip) {
            Tooltips.hide(root.tip);
            root.tip = 0;
        } else if (focus.has-focus && !area.has-hover) {
            root.show-tip();
        }
    }

    Image {
        x: root.compact ? (parent.width - self.width) / 2 : Theme.gap-m;
        width: 20px;
        height: 20px;
        source: root.icon;
        colorize: root.ink;
    }

    if !root.compact: Text {
        x: Theme.gap-m + 20px + Theme.gap-m;
        width: parent.width - self.x - Theme.gap-m;
        text: root.text;
        color: root.ink;
        font-size: 15px;
        font-weight: root.selected ? 600 : 500;
        vertical-alignment: center;
        overflow: elide;
    }

    area := TouchArea {
        clicked => { root.chosen(); }
    }

    focus := FocusScope {
        focus-on-click: false;
        key-pressed(event) => {
            if (event.text == Key.Return || event.text == Key.Space) {
                root.chosen();
                return accept;
            }
            reject
        }
    }

    Timer {
        interval: 500ms;
        running: area.has-hover && !root.tip-shown && root.wants-tip;
        triggered => { root.show-tip(); }
    }

    FocusRing {
        focused: focus.has-focus;
        radius: root.border-radius;
    }
}

// The measures every setting row shares (FR-034, the approved mockup page).
global Rows {
    out property <length> height: 58px;
    // The rows run the content's full width (the hover gradient reaches both edges); their text
    // and controls keep this distance from them.
    out property <length> pad: 24px;
    out property <length> text: 15px;
}

// A setting row: no outline, a hairline under it (none under the category's last row), the soft
// accent gradient while the pointer is over it.
component Row inherits Rectangle {
    in property <bool> hovered;
    in property <bool> last;

    Rectangle {
        background: @linear-gradient(90deg, Theme.c.accent-soft 0%, Theme.c.accent-soft.transparentize(1) 75%);
        opacity: root.hovered ? 1 : 0;
        animate opacity { duration: Theme.quick; }
    }

    if !root.last: Rectangle {
        y: parent.height - self.height;
        height: 1px;
        background: Theme.c.hover;
    }

    @children
}

// One setting: its name and a switch; a click anywhere on the row flips it.
component ToggleRow inherits Row {
    in property <string> text;
    in-out property <bool> checked;
    callback toggled(bool);

    height: max(Rows.height, label.preferred-height + 2 * Theme.gap-m);
    hovered: area.has-hover;

    // The row's content sits inside its touch area, so the row stays hovered over the switch.
    area := TouchArea {
        clicked => { toggle.flip(); }

        label := Text {
            x: Rows.pad;
            width: parent.width - toggle.width - 2 * Rows.pad - Theme.gap-m;
            height: parent.height;
            text: root.text;
            color: Theme.c.text;
            font-size: Rows.text;
            wrap: word-wrap;
            vertical-alignment: center;
        }

        toggle := Toggle {
            x: parent.width - self.width - Rows.pad;
            y: (parent.height - self.height) / 2;
            label: root.text;
            checked <=> root.checked;
            toggled(on) => { root.toggled(on); }
        }
    }
}

// One setting with a few choices: its name and a select; a click anywhere on the row opens it.
// With `icon-only` the select shows the chosen item's icon, its menu a grid `columns` wide.
component SelectRow inherits Row {
    in property <string> text;
    in property <[MenuItem]> items;
    in-out property <int> current;
    in property <bool> icon-only;
    in property <int> columns: 1;
    callback selected(int);

    height: max(Rows.height, label.preferred-height + 2 * Theme.gap-m);
    hovered: area.has-hover;

    area := TouchArea {
        clicked => { select.open-menu(); }

        label := Text {
            x: Rows.pad;
            width: parent.width - select.width - 2 * Rows.pad - Theme.gap-m;
            height: parent.height;
            text: root.text;
            color: Theme.c.text;
            font-size: Rows.text;
            wrap: word-wrap;
            vertical-alignment: center;
        }

        // Text dropdowns share one width (FR-034).
        select := Select {
            x: parent.width - self.width - Rows.pad;
            y: (parent.height - self.height) / 2;
            width: root.icon-only ? self.preferred-width : min(200px, parent.width / 2);
            icon-only: root.icon-only;
            columns: root.columns;
            label: root.text;
            items: root.items;
            current <=> root.current;
            selected(index) => { root.selected(index); }
        }
    }
}

// One setting with two or three short choices: its name and a segmented control (FR-031); the
// control goes under the name when both do not fit on one line. Only a click on a segment picks.
component SegmentedRow inherits Row {
    in property <string> text;
    in property <[string]> options;
    in-out property <int> current;
    callback selected(int);

    property <bool> stacked: label.preferred-width + segmented.preferred-width + 2 * Rows.pad + Theme.gap-m > root.width;

    height: root.stacked ? label.preferred-height + segmented.height + 3 * Theme.gap-m
        : max(Rows.height, label.preferred-height + 2 * Theme.gap-m);
    hovered: area.has-hover;

    area := TouchArea {
        label := Text {
            x: Rows.pad;
            y: root.stacked ? Theme.gap-m : (parent.height - self.height) / 2;
            width: root.stacked ? parent.width - 2 * Rows.pad : parent.width - segmented.width - 2 * Rows.pad - Theme.gap-m;
            text: root.text;
            color: Theme.c.text;
            font-size: Rows.text;
            wrap: word-wrap;
        }

        segmented := Segmented {
            x: root.stacked ? Rows.pad : parent.width - self.width - Rows.pad;
            y: root.stacked ? label.y + label.height + Theme.gap-m : (parent.height - self.height) / 2;
            width: min(self.preferred-width, parent.width - 2 * Rows.pad);
            label: root.text;
            options: root.options;
            current <=> root.current;
            selected(index) => { root.selected(index); }
        }
    }
}

export component SettingsPanel inherits Raised {
    // The compact layout (FR-009): the column keeps only the icons.
    in property <bool> compact;
    callback close();

    // Created each time the panel opens (`if` in main.slint), so it opens on General.
    init => { Prefs.opened(); }

    property <Category> category: Category.general;
    property <[CategoryEntry]> categories: [
        { id: Category.general, icon: @image-url("../assets/icons/adjustments_horizontal.svg") },
        { id: Category.appearance, icon: @image-url("../assets/icons/palette.svg") },
        { id: Category.preview, icon: @image-url("../assets/icons/device_tv.svg") },
        { id: Category.about, icon: @image-url("../assets/icons/info_circle.svg") },
    ];

    // The category column runs the panel's full height on the base tone (FR-034).
    property <length> nav-pad: 10px;
    property <length> nav-width: root.compact ? 44px + 2 * root.nav-pad : 210px;
    // Where the rows start: under the close control.
    property <length> content-y: 52px;

    fill: Theme.c.raised;
    accessible-role: groupbox;
    accessible-label: @tr("Settings");

    // Clicks on the panel stay on it.
    TouchArea { }

    // The categories come first in the focus order, then the rows, then the close control.
    Rectangle {
        x: 0;
        y: 0;
        width: root.nav-width;
        height: root.height;
        border-top-left-radius: root.radius;
        border-bottom-left-radius: root.radius;
        background: Theme.c.base;

        VerticalLayout {
            padding: root.nav-pad;
            spacing: 4px;
            alignment: start;

            // The panel's title; compact, only its icon.
            HorizontalLayout {
                padding-left: root.compact ? (44px - 22px) / 2 : 12px;
                padding-right: 12px;
                padding-top: 10px;
                padding-bottom: 16px;
                spacing: 10px;

                VerticalLayout {
                    alignment: center;
                    horizontal-stretch: 0;
                    Image {
                        width: 22px;
                        height: 22px;
                        source: @image-url("../assets/icons/settings.svg");
                        colorize: Theme.c.text;
                        accessible-role: none;
                    }
                }

                if !root.compact: Text {
                    text: @tr("Settings");
                    color: Theme.c.text;
                    font-size: Theme.text-l;
                    font-weight: 600;
                    vertical-alignment: center;
                    overflow: elide;
                    accessible-role: none;
                }
            }

            for entry in root.categories: CategoryItem {
                id: entry.id;
                icon: entry.icon;
                compact: root.compact;
                selected: entry.id == root.category;
                chosen => { root.category = entry.id; }
            }
        }
    }

    // The rows run the content's full width; their own padding keeps the text off the edges.
    Flickable {
        x: root.nav-width;
        y: root.content-y;
        width: root.width - root.nav-width;
        height: root.height - root.content-y;
        content-height: max(self.height, content.preferred-height);

        content := VerticalLayout {
            alignment: start;
            padding-bottom: 16px;

            if root.category == Category.general: ToggleRow {
                text: @tr("Start in fullscreen");
                checked <=> Prefs.start-fullscreen;
                toggled(on) => { Prefs.start-fullscreen-changed(on); }
            }

            if root.category == Category.general && Prefs.tray-available: ToggleRow {
                text: @tr("Keep in tray when closed");
                checked <=> Prefs.keep-in-tray;
                toggled(on) => { Prefs.keep-in-tray-changed(on); }
            }

            if root.category == Category.general: ToggleRow {
                text: @tr("Start with the system");
                checked <=> Prefs.start-with-system;
                toggled(on) => { Prefs.start-with-system-changed(on); }
            }

            // Every corner drawn with the button's icon: the frame and the mark in that corner.
            if root.category == Category.general: SelectRow {
                text: @tr("Notification position");
                last: true;
                icon-only: true;
                columns: 2;
                items: [
                    {
                        text: @tr("Top left"),
                        icon: @image-url("../assets/icons/corner_frame.svg"),
                        accent: @image-url("../assets/icons/corner_mark_top_left.svg"),
                    },
                    {
                        text: @tr("Top right"),
                        icon: @image-url("../assets/icons/corner_frame.svg"),
                        accent: @image-url("../assets/icons/corner_mark_top_right.svg"),
                    },
                    {
                        text: @tr("Bottom left"),
                        icon: @image-url("../assets/icons/corner_frame.svg"),
                        accent: @image-url("../assets/icons/corner_mark_bottom_left.svg"),
                    },
                    {
                        text: @tr("Bottom right"),
                        icon: @image-url("../assets/icons/corner_frame.svg"),
                        accent: @image-url("../assets/icons/corner_mark_bottom_right.svg"),
                    },
                ];
                current <=> Prefs.notification-position;
                selected(index) => { Prefs.notification-position-changed(index); }
            }

            if root.category == Category.appearance: SelectRow {
                text: @tr("Language");
                items: Prefs.languages;
                current <=> Prefs.language;
                selected(index) => { Prefs.language-changed(index); }
            }

            if root.category == Category.appearance: SelectRow {
                text: @tr("Theme");
                last: true;
                items: [{ text: @tr("Automatic") }, { text: @tr("Dark") }, { text: @tr("Light") }];
                current <=> Prefs.theme;
                selected(index) => { Prefs.theme-changed(index); }
            }

            if root.category == Category.preview: SegmentedRow {
                text: @tr("Video background");
                options: [@tr("Theme"), @tr("Black")];
                current <=> Prefs.background;
                selected(index) => { Prefs.background-changed(index); }
            }

            if root.category == Category.preview: ToggleRow {
                text: @tr("Watermark");
                checked <=> Prefs.watermark;
                toggled(on) => { Prefs.watermark-changed(on); }
            }

            if root.category == Category.preview: SegmentedRow {
                text: @tr("Video shadow");
                last: true;
                options: [@tr("Always"), @tr("With ambient light"), @tr("Off")];
                current <=> Prefs.shadow;
                selected(index) => { Prefs.shadow-changed(index); }
            }

            if root.category == Category.about: VerticalLayout {
                padding-left: Rows.pad;
                padding-right: Rows.pad;
                padding-top: Theme.gap-m;
                spacing: Theme.gap-s;

                // The wordmark in the theme's text color (FR-006), in its aspect ratio (816 × 199.89).
                Image {
                    source: Theme.dark ? @image-url("../../../brand/CapturaX-light.svg")
                        : @image-url("../../../brand/CapturaX-dark.svg");
                    width: 32px * 816 / 199.89;
                    height: 32px;
                    accessible-role: image;
                    accessible-label: Texts.app-name;
                }

                Text {
                    text: @tr("Version {}", Prefs.version);
                    color: Theme.c.text-muted;
                    font-size: Theme.text-m;
                }
            }
        }
    }

    // Last, so it is last in the focus order: the close control at the content's top right.
    IconButton {
        x: root.width - self.width - 8px;
        y: 8px;
        size: 36px;
        icon-size: 18px;
        icon: @image-url("../assets/icons/close.svg");
        tooltip: @tr("Close (Esc)");
        tooltip-side: Side.bottom;
        clicked => { root.close(); }
    }
}
