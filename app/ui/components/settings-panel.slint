// The settings panel (FR-025, look FR-034): a raised panel centered over the dimmed video, opened
// from the dock's settings button and closed with Esc, its close control or a click outside it;
// the video keeps playing behind it. A column on the base tone runs its full height with the
// settings icon and "Settings" at its top, then the categories with their icons; the chosen
// one's rows fill the rest, the close control at its top right. In the compact layout the column
// keeps only the icons, names in tooltips. Each change is reported to Rust, which saves it at
// once (FR-029). The values live in the global `Prefs`, set by Rust.
import { Theme } from "../theme.slint";
import { Texts } from "../texts.slint";
import { Toggle } from "toggle.slint";
import { Tooltips, Side } from "tooltip.slint";
import { Raised } from "raised.slint";
import { IconButton } from "icon-button.slint";
import { FocusRing, Input } from "focus-ring.slint";
import { Select } from "select.slint";
import { MenuItem } from "menu.slint";
import { Segmented } from "segmented.slint";
import { Tag } from "tag.slint";
import { ActionButton } from "action-button.slint";

// One audio endpoint in the Audio category (preview audio FR-014), set by Rust.
export struct AudioEndpointRow {
    id: string,
    name: string,
    exclusive: bool,
    // The preview plays on it now: the `Preview` tag (later specs add their own users).
    in-use: bool,
}

// One action in the Hotkeys category (screenshot FR-016), set by Rust.
export struct HotkeyRowData {
    action: string,
    // The action's name in the current language.
    name: string,
    // The key as shown (`Ctrl+F8`, `Win+Shift+S`), empty when none.
    key: string,
    // The default key as shown; empty when the action has no default.
    default-key: string,
    // The key is the default: no Reset.
    is-default: bool,
    // Waiting for a key (FR-016, FR-017).
    recording: bool,
    // Why the last key was refused, empty when none.
    refusal: string,
}

// Later specs add their categories here (F40), with their names in `CategoryItem`.
export enum Category { general, appearance, preview, audio, folders, hotkeys, about }

export global Prefs {
    // The category shown: General when the panel opens from its button (main.slint sets it back
    // when the panel closes); Rust sets Folders before opening it from a notice's **Settings**
    // (screenshot FR-008).
    in-out property <Category> settings-category: Category.general;
    in-out property <bool> start-fullscreen;
    in-out property <bool> keep-in-tray;
    in-out property <bool> start-with-system;
    // Keep in tray shows only where the desktop has a tray (FR-014a).
    in property <bool> tray-available: true;
    in property <string> version;
    // Automatic, then each language's name in itself (FR-024), built by Rust from its list, so a
    // new language needs no change here.
    in property <[MenuItem]> languages;
    // The chosen entries: of `languages`, and of Automatic, Dark, Light.
    in-out property <int> language;
    in-out property <int> theme;
    // The corner the in-app notices show in (FR-032), in the grid's order: 0 top left, 1 top
    // right, 2 bottom left (the default), 3 bottom right.
    in-out property <int> notification-position: 2;
    callback notification-position-changed(int);
    // Preview (F56–F58): the video background (0 Theme, 1 Black), the watermark, and the video
    // shadow (0 Always, 1 With ambient light, 2 Off).
    in-out property <int> background;
    in-out property <bool> watermark: true;
    in-out property <int> shadow: 0;
    // Presentation (FR-022): 0 Lowest latency (the default), 1 Follow the monitor.
    in-out property <int> presentation: 0;
    // The Audio category (preview audio FR-014): exclusive mode, Windows only
    // (`platform::IS_WINDOWS`); every input and output of the computer with its switch.
    in property <bool> exclusive-available;
    in property <[AudioEndpointRow]> audio-inputs;
    in property <[AudioEndpointRow]> audio-outputs;
    // An endpoint's switch asked to change (by id); Rust saves it and sets the row.
    callback exclusive-changed(string, bool);
    // The Hotkeys category (screenshot FR-016): each action's row, and whether keys work only
    // while the window has the focus (FR-012). A click on a key starts recording it (again:
    // stops); Rust reads the keys pressed before Slint sees them, so Esc cancels without closing
    // the panel. A category change or the panel's closing cancels too.
    in property <[HotkeyRowData]> hotkeys;
    in property <bool> hotkeys-window-only;
    // Under Wayland with the portal the desktop owns the keys (screenshot Edge Cases): the rows
    // show its keys, have no Clear or Reset, and a click on a key opens the desktop's shortcut
    // settings; when it cannot, the category says where to change them until another category.
    in property <bool> hotkeys-by-desktop;
    in-out property <bool> hotkeys-desktop-dialog-missing;
    callback hotkey-record(string);
    callback hotkey-cancel();
    callback hotkey-clear(string);
    callback hotkey-reset(string);
    // The Folders category (screenshot FR-020): the folder shortened, its full path, the
    // default folder shortened (Reset's tooltip), whether the default is in use (no Reset), and
    // whether the last Change found no folder dialog (Linux without the portal).
    in property <string> screenshot-folder;
    in property <string> screenshot-folder-path;
    in property <string> screenshot-default-folder;
    in property <bool> screenshot-folder-is-default: true;
    in-out property <bool> folder-picker-missing;
    callback screenshot-folder-change();
    callback screenshot-folder-open();
    callback screenshot-folder-reset();
    callback background-changed(int);
    callback watermark-changed(bool);
    callback shadow-changed(int);
    callback presentation-changed(int);
    callback start-fullscreen-changed(bool);
    callback keep-in-tray-changed(bool);
    callback start-with-system-changed(bool);
    callback language-changed(int);
    callback theme-changed(int);
    // The panel opened: Rust reads the system's autostart entry again (FR-014b).
    callback opened();
}

// No text here: a translated name in the list would make a language switch build the items
// again, losing the keyboard focus and leaving a shown tooltip in the old language.
struct CategoryEntry {
    id: Category,
    icon: image,
}

// One category in the column: its icon and name, tinted with the soft accent while chosen, as a
// toggled tool button (the dock's settings button). Compact, only the icon, with the name in a
// tooltip (after 500 ms of hover, or at once on keyboard focus). A click, Enter or Space chooses
// it.
component CategoryItem inherits Rectangle {
    in property <Category> id;
    in property <image> icon;
    in property <bool> selected;
    in property <bool> compact;
    callback chosen();

    // Created with the panel or when the layout switches: the chosen category takes the focus, so
    // the keyboard starts inside the panel (the ring shows only after a key).
    init => {
        if (root.selected) {
            focus.focus();
        }
    }

    property <string> text: root.id == Category.general ? @tr("General")
        : root.id == Category.appearance ? @tr("Appearance")
        : root.id == Category.preview ? @tr("Preview")
        : root.id == Category.audio ? @tr("Audio")
        : root.id == Category.folders ? @tr("Folders")
        : root.id == Category.hotkeys ? @tr("Hotkeys")
        : @tr("About");

    // The token of the tooltip shown, 0 when none.
    property <int> tip;
    // Its tooltip still shows: a size change or another control's tooltip hides it without telling.
    property <bool> tip-shown: root.tip > 0 && root.tip == Tooltips.owner;
    property <bool> wants-tip: root.compact && (area.has-hover || (focus.has-focus && Input.keyboard));
    property <color> ink: root.selected ? Theme.c.accent-text : area.has-hover ? Theme.c.text : Theme.c.text-muted;

    height: 44px;
    border-radius: 12px;
    background: root.selected ? Theme.c.accent-soft : area.has-hover ? Theme.c.hover : transparent;
    animate background { duration: Theme.quick; }

    accessible-role: AccessibleRole.tab;
    accessible-label: root.text;
    accessible-item-selectable: true;
    accessible-item-selected: root.selected;
    accessible-action-default => { root.chosen(); }

    forward-focus: focus;

    function show-tip() {
        root.tip = Tooltips.show(root.text, Side.right,
            root.absolute-position.x, root.absolute-position.y, root.width, root.height);
    }

    // A language switch changes the text of a tooltip that shows (FR-024).
    changed text => {
        if (root.tip-shown) {
            root.show-tip();
        }
    }

    changed wants-tip => {
        if (!self.wants-tip) {
            Tooltips.hide(root.tip);
            root.tip = 0;
        } else if (focus.has-focus && !area.has-hover) {
            root.show-tip();
        }
    }

    Image {
        x: root.compact ? (parent.width - self.width) / 2 : Theme.gap-m;
        width: 20px;
        height: 20px;
        source: root.icon;
        colorize: root.ink;
    }

    if !root.compact: Text {
        x: Theme.gap-m + 20px + Theme.gap-m;
        width: parent.width - self.x - Theme.gap-m;
        text: root.text;
        color: root.ink;
        font-size: 15px;
        font-weight: root.selected ? 600 : 500;
        vertical-alignment: center;
        overflow: elide;
    }

    area := TouchArea {
        clicked => { root.chosen(); }
    }

    focus := FocusScope {
        focus-on-click: false;
        key-pressed(event) => {
            if (event.text == Key.Return || event.text == Key.Space) {
                root.chosen();
                return accept;
            }
            reject
        }
    }

    Timer {
        interval: 500ms;
        running: area.has-hover && !root.tip-shown && root.wants-tip;
        triggered => { root.show-tip(); }
    }

    FocusRing {
        focused: focus.has-focus;
        radius: root.border-radius;
    }
}

// The measures every setting row shares (FR-034, the approved mockup page).
global Rows {
    out property <length> height: 58px;
    // The rows run the content's full width (the hover gradient reaches both edges); their text
    // and controls keep this distance from them.
    out property <length> pad: 24px;
    out property <length> text: 15px;
}

// A setting row: no outline, a hairline under it (none under the category's last row), the soft
// accent gradient while the pointer is over it.
component Row inherits Rectangle {
    in property <bool> hovered;
    in property <bool> last;

    Rectangle {
        background: @linear-gradient(90deg, Theme.c.accent-soft 0%, Theme.c.accent-soft.transparentize(1) 75%);
        opacity: root.hovered ? 1 : 0;
        animate opacity { duration: Theme.quick; }
    }

    if !root.last: Rectangle {
        y: parent.height - self.height;
        height: 1px;
        background: Theme.c.hover;
    }

    @children
}

// One setting: its name and a switch; a click anywhere on the row flips it.
component ToggleRow inherits Row {
    in property <string> text;
    in-out property <bool> checked;
    callback toggled(bool);

    height: max(Rows.height, label.preferred-height + 2 * Theme.gap-m);
    hovered: area.has-hover;

    // The row's content sits inside its touch area, so the row stays hovered over the switch.
    area := TouchArea {
        clicked => { toggle.flip(); }

        label := Text {
            x: Rows.pad;
            width: parent.width - toggle.width - 2 * Rows.pad - Theme.gap-m;
            height: parent.height;
            text: root.text;
            color: Theme.c.text;
            font-size: Rows.text;
            wrap: word-wrap;
            vertical-alignment: center;
        }

        toggle := Toggle {
            x: parent.width - self.width - Rows.pad;
            y: (parent.height - self.height) / 2;
            label: root.text;
            checked <=> root.checked;
            toggled(on) => { root.toggled(on); }
        }
    }
}

// One setting with a few choices: its name and a select; a click anywhere on the row opens it.
// With `icon-only` the select shows the chosen item's icon, its menu a grid `columns` wide.
component SelectRow inherits Row {
    in property <string> text;
    in property <[MenuItem]> items;
    in-out property <int> current;
    in property <bool> icon-only;
    in property <int> columns: 1;
    callback selected(int);

    height: max(Rows.height, label.preferred-height + 2 * Theme.gap-m);
    hovered: area.has-hover;

    area := TouchArea {
        clicked => { select.open-menu(); }

        label := Text {
            x: Rows.pad;
            width: parent.width - select.width - 2 * Rows.pad - Theme.gap-m;
            height: parent.height;
            text: root.text;
            color: Theme.c.text;
            font-size: Rows.text;
            wrap: word-wrap;
            vertical-alignment: center;
        }

        // Text dropdowns share one width (FR-034).
        select := Select {
            x: parent.width - self.width - Rows.pad;
            y: (parent.height - self.height) / 2;
            width: root.icon-only ? self.preferred-width : min(200px, parent.width / 2);
            icon-only: root.icon-only;
            columns: root.columns;
            label: root.text;
            items: root.items;
            current <=> root.current;
            selected(index) => { root.selected(index); }
        }
    }
}

// One setting with two or three short choices: its name and a segmented control (FR-031); the
// control goes under the name when both do not fit on one line. Only a click on a segment picks.
// A `tooltip` shows over the name after 500 ms of hover on the row, or at once when the control
// takes the keyboard focus.
component SegmentedRow inherits Row {
    in property <string> text;
    in property <[string]> options;
    in-out property <int> current;
    in property <string> tooltip;
    callback selected(int);

    // The token of the tooltip shown, 0 when none.
    property <int> tip;
    // Its tooltip still shows: a size change or another control's tooltip hides it without telling.
    property <bool> tip-shown: root.tip > 0 && root.tip == Tooltips.owner;
    property <bool> wants-tip: root.tooltip != "" && (area.has-hover || (segmented.has-focus && Input.keyboard));

    function show-tip() {
        root.tip = Tooltips.show(root.tooltip, Side.top,
            label.absolute-position.x, label.absolute-position.y, label.width, label.height);
    }

    // A language switch changes the text of a tooltip that shows (FR-024).
    changed tooltip => {
        if (root.tip-shown) {
            root.show-tip();
        }
    }

    changed wants-tip => {
        if (!self.wants-tip) {
            Tooltips.hide(root.tip);
            root.tip = 0;
        } else if (segmented.has-focus && !area.has-hover) {
            root.show-tip();
        }
    }

    Timer {
        interval: 500ms;
        running: area.has-hover && !root.tip-shown && root.wants-tip;
        triggered => { root.show-tip(); }
    }

    property <bool> stacked: label.preferred-width + segmented.preferred-width + 2 * Rows.pad + Theme.gap-m > root.width;

    height: root.stacked ? label.preferred-height + segmented.height + 3 * Theme.gap-m
        : max(Rows.height, label.preferred-height + 2 * Theme.gap-m);
    hovered: area.has-hover;

    area := TouchArea {
        label := Text {
            x: Rows.pad;
            y: root.stacked ? Theme.gap-m : (parent.height - self.height) / 2;
            width: root.stacked ? parent.width - 2 * Rows.pad : parent.width - segmented.width - 2 * Rows.pad - Theme.gap-m;
            text: root.text;
            color: Theme.c.text;
            font-size: Rows.text;
            wrap: word-wrap;
        }

        segmented := Segmented {
            x: root.stacked ? Rows.pad : parent.width - self.width - Rows.pad;
            y: root.stacked ? label.y + label.height + Theme.gap-m : (parent.height - self.height) / 2;
            width: min(self.preferred-width, parent.width - 2 * Rows.pad);
            label: root.text;
            description: root.tooltip;
            options: root.options;
            current <=> root.current;
            selected(index) => { root.selected(index); }
        }
    }
}

// The Audio category's heading: its name with the line under it.
component Heading inherits VerticalLayout {
    in property <string> text;
    in property <string> line;

    padding-left: Rows.pad;
    padding-right: Rows.pad;
    padding-top: Theme.gap-s;
    padding-bottom: Theme.gap-s;
    spacing: 4px;

    Text {
        text: root.text;
        color: Theme.c.text;
        font-size: Rows.text;
        font-weight: 600;
        wrap: word-wrap;
    }

    Text {
        text: root.line;
        color: Theme.c.text-muted;
        font-size: Theme.text-m;
        wrap: word-wrap;
    }
}

// Tabs over a list (the Audio category's Inputs and Outputs): the names in a row, the chosen one
// in the text tone over an accent bar, a hairline under them all. One Tab stop; Left and Right
// (Home, End too) switch; a click chooses a tab.
component Tabs inherits Rectangle {
    in property <[string]> tabs;
    in-out property <int> current;
    // What the tabs choose between, for screen readers.
    in property <string> label;
    // False keeps it out of the Tab order (another category shows).
    in property <bool> focusable: true;

    function choose(index: int) {
        if (index >= 0 && index < root.tabs.length) {
            root.current = index;
        }
    }

    height: 40px;
    accessible-role: tab-list;
    accessible-label: root.label;
    forward-focus: focus;

    focus := FocusScope {
        enabled: root.focusable;
        focus-on-click: false;
        key-pressed(event) => {
            if (event.text == Key.LeftArrow) {
                root.choose(root.current - 1);
                return accept;
            }
            if (event.text == Key.RightArrow) {
                root.choose(root.current + 1);
                return accept;
            }
            if (event.text == Key.Home) {
                root.choose(0);
                return accept;
            }
            if (event.text == Key.End) {
                root.choose(root.tabs.length - 1);
                return accept;
            }
            reject
        }
    }

    Rectangle {
        x: Rows.pad;
        y: parent.height - 1px;
        width: parent.width - 2 * Rows.pad;
        height: 1px;
        background: Theme.c.hover;
    }

    HorizontalLayout {
        x: Rows.pad - 12px;
        alignment: start;

        for tab[index] in root.tabs: cell := Rectangle {
            property <bool> chosen: index == root.current;

            accessible-role: AccessibleRole.tab;
            accessible-label: tab;
            accessible-item-selected: self.chosen;
            accessible-item-selectable: true;

            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;

                Text {
                    text: tab;
                    color: cell.chosen || area.has-hover ? Theme.c.text : Theme.c.text-muted;
                    font-size: Theme.text-m;
                    font-weight: 600;
                    vertical-alignment: center;
                }
            }

            Rectangle {
                y: parent.height - self.height;
                height: 2px;
                background: Theme.c.accent;
                opacity: parent.chosen ? 1 : 0;
                animate opacity { duration: Theme.quick; }
            }

            area := TouchArea {
                clicked => { root.choose(index); }
            }
        }
    }

    FocusRing {
        focused: focus.has-focus;
        radius: 8px;
    }
}

// The column headers over the endpoint list: the device's name, the Exclusive switch.
component ColumnHeads inherits HorizontalLayout {
    padding-left: Rows.pad;
    padding-right: Rows.pad;
    padding-top: Theme.gap-m;
    padding-bottom: 4px;

    Text {
        text: @tr("Device");
        color: Theme.c.text-faint;
        font-size: Theme.text-s;
        font-weight: 600;
        horizontal-stretch: 1;
    }

    Text {
        text: @tr("Exclusive");
        color: Theme.c.text-faint;
        font-size: Theme.text-s;
        font-weight: 600;
        horizontal-alignment: right;
    }
}

// An audio endpoint with its Exclusive switch (preview audio FR-014), its name whole and, under
// it, the `Preview` tag while the preview plays on it (a row of tags: recording and streaming add
// theirs later); a click anywhere on the row flips the switch. The switch only asks: Rust
// saves the value and sets the row.
component EndpointRow inherits Row {
    in property <AudioEndpointRow> endpoint;
    callback toggled(bool);

    height: max(Rows.height, texts.preferred-height + 2 * Theme.gap-m);
    hovered: area.has-hover;

    area := TouchArea {
        clicked => { switch.flip(); }

        texts := VerticalLayout {
            x: Rows.pad;
            width: parent.width - switch.width - 2 * Rows.pad - Theme.gap-m;
            height: parent.height;
            alignment: center;
            spacing: 4px;

            Text {
                text: root.endpoint.name;
                color: Theme.c.text;
                font-size: Rows.text;
                wrap: word-wrap;
            }

            if root.endpoint.in-use: HorizontalLayout {
                alignment: start;
                spacing: 6px;
                Tag {
                    value: @tr("Preview");
                    kind: "rate";
                }
            }
        }

        switch := Toggle {
            x: parent.width - self.width - Rows.pad;
            y: (parent.height - self.height) / 2;
            held: true;
            label: root.endpoint.name;
            description: @tr("Exclusive");
            checked: root.endpoint.exclusive;
            toggled(on) => { root.toggled(on); }
        }
    }
}

// An action with its key (screenshot FR-016): its name, under it the refusal of the last key
// pressed (or how to cancel while recording); then the key button, which records a new key
// ("Press a key…", filled with the accent while recording), **Clear** while it has a key and
// **Reset** while the key is not the default. Clear and Reset keep their places when hidden, so
// the key button does not move.
component HotkeyRow inherits Row {
    in property <HotkeyRowData> data;
    callback record();
    callback clear();
    callback reset();

    property <string> line: root.data.refusal != "" ? root.data.refusal
        : root.data.recording ? @tr("Esc to cancel")
        : "";

    height: max(Rows.height, texts.preferred-height + 2 * Theme.gap-m);
    hovered: area.has-hover;

    area := TouchArea {
        texts := VerticalLayout {
            x: Rows.pad;
            width: key.x - Rows.pad - Theme.gap-m;
            height: parent.height;
            alignment: center;
            spacing: 4px;

            Text {
                text: root.data.name;
                color: Theme.c.text;
                font-size: Rows.text;
                wrap: word-wrap;
            }

            if root.line != "": Text {
                text: root.line;
                color: root.data.refusal != "" ? Theme.c.warn : Theme.c.text-muted;
                font-size: Theme.text-m;
                wrap: word-wrap;
            }
        }

        // Placed by hand: a layout here would hand its fixed width to the row as its maximum.
        // Where the desktop owns the keys there is no Clear or Reset: the key takes the edge.
        key := ActionButton {
            x: Prefs.hotkeys-by-desktop ? parent.width - self.width - Rows.pad : clear.x - 4px - self.width;
            y: (parent.height - self.height) / 2;
            width: max(150px, self.preferred-width);
            primary: root.data.recording;
            label: root.data.recording ? @tr("Press a key…")
                : root.data.key == "" ? @tr("None")
                : root.data.key;
            clicked => { root.record(); }
        }

        clear := IconButton {
            x: reset.x - 4px - self.width;
            y: (parent.height - self.height) / 2;
            size: 36px;
            icon-size: 18px;
            filled: true;
            icon: @image-url("../assets/icons/backspace.svg");
            tooltip: @tr("Clear");
            visible: root.data.key != "" && !Prefs.hotkeys-by-desktop;
            focusable: self.visible;
            clicked => { root.clear(); }
        }

        reset := IconButton {
            x: parent.width - self.width - Rows.pad;
            y: (parent.height - self.height) / 2;
            size: 36px;
            icon-size: 18px;
            filled: true;
            icon: @image-url("../assets/icons/arrow_back_up.svg");
            tooltip: root.data.default-key == "" ? @tr("Reset") : @tr("Reset to {}", root.data.default-key);
            visible: !root.data.is-default && !Prefs.hotkeys-by-desktop;
            focusable: self.visible;
            clicked => { root.reset(); }
        }
    }
}

// A folder of the Folders category (screenshot FR-020; spec #9 adds the recordings one): its name, under it the folder shortened (the full
// path in a tooltip after 500 ms of hover on it) or why Change did nothing; then **Change** (the
// system's folder dialog), **Open** (the file manager on it) and **Reset** while a folder other
// than the default is set. Reset keeps its place when hidden, so the buttons do not move.
component FolderRow inherits Row {
    callback change();
    callback open();
    callback reset();

    // The token of the tooltip shown, 0 when none.
    property <int> tip;
    // Its tooltip still shows: a size change or another control's tooltip hides it without telling.
    property <bool> tip-shown: root.tip > 0 && root.tip == Tooltips.owner;
    property <bool> wants-tip: path-area.has-hover && Prefs.screenshot-folder-path != "";

    function show-tip() {
        root.tip = Tooltips.show(Prefs.screenshot-folder-path, Side.top,
            path.absolute-position.x, path.absolute-position.y, path.width, path.height);
    }

    changed wants-tip => {
        if (!self.wants-tip) {
            Tooltips.hide(root.tip);
            root.tip = 0;
        }
    }

    Timer {
        interval: 500ms;
        running: root.wants-tip && !root.tip-shown;
        triggered => { root.show-tip(); }
    }

    height: max(Rows.height, texts.preferred-height + 2 * Theme.gap-m);
    hovered: area.has-hover;

    area := TouchArea {
        texts := VerticalLayout {
            x: Rows.pad;
            width: change.x - Rows.pad - Theme.gap-m;
            height: parent.height;
            alignment: center;
            spacing: 4px;

            Text {
                text: @tr("Screenshots");
                color: Theme.c.text;
                font-size: Rows.text;
                wrap: word-wrap;
            }

            path := Text {
                text: Prefs.screenshot-folder;
                color: Theme.c.text-muted;
                font-size: Theme.text-m;
                overflow: elide;
                accessible-description: Prefs.screenshot-folder-path;

                path-area := TouchArea { }
            }

            if Prefs.folder-picker-missing: Text {
                text: @tr("No folder picker on this desktop");
                color: Theme.c.warn;
                font-size: Theme.text-m;
                wrap: word-wrap;
            }
        }

        // Placed by hand: a layout here would hand its fixed width to the row as its maximum.
        change := ActionButton {
            x: open.x - 4px - self.width;
            y: (parent.height - self.height) / 2;
            width: max(96px, self.preferred-width);
            label: @tr("Change");
            clicked => { root.change(); }
        }

        open := ActionButton {
            x: reset.x - 4px - self.width;
            y: (parent.height - self.height) / 2;
            width: max(96px, self.preferred-width);
            label: @tr("Open");
            clicked => { root.open(); }
        }

        reset := IconButton {
            x: parent.width - self.width - Rows.pad;
            y: (parent.height - self.height) / 2;
            size: 36px;
            icon-size: 18px;
            filled: true;
            icon: @image-url("../assets/icons/arrow_back_up.svg");
            tooltip: @tr("Reset to {}", Prefs.screenshot-default-folder);
            visible: !Prefs.screenshot-folder-is-default;
            focusable: self.visible;
            clicked => { root.reset(); }
        }
    }
}

export component SettingsPanel inherits Raised {
    // The compact layout (FR-009): the column keeps only the icons.
    in property <bool> compact;
    callback close();

    // Created each time the panel opens (`if` in main.slint).
    init => { Prefs.opened(); }

    property <Category> category <=> Prefs.settings-category;
    // The Audio category's tab: 0 Inputs, 1 Outputs. Another tab's list starts at its top.
    property <int> audio-tab;
    changed audio-tab => { rows.content-y = 0; }
    // Audio only on Windows (preview audio FR-014: its only setting is exclusive mode).
    property <[CategoryEntry]> categories: Prefs.exclusive-available ? [
        { id: Category.general, icon: @image-url("../assets/icons/adjustments_horizontal.svg") },
        { id: Category.appearance, icon: @image-url("../assets/icons/palette.svg") },
        { id: Category.preview, icon: @image-url("../assets/icons/device_tv.svg") },
        { id: Category.audio, icon: @image-url("../assets/icons/volume.svg") },
        { id: Category.folders, icon: @image-url("../assets/icons/folder.svg") },
        { id: Category.hotkeys, icon: @image-url("../assets/icons/keyboard.svg") },
        { id: Category.about, icon: @image-url("../assets/icons/info_circle.svg") },
    ] : [
        { id: Category.general, icon: @image-url("../assets/icons/adjustments_horizontal.svg") },
        { id: Category.appearance, icon: @image-url("../assets/icons/palette.svg") },
        { id: Category.preview, icon: @image-url("../assets/icons/device_tv.svg") },
        { id: Category.folders, icon: @image-url("../assets/icons/folder.svg") },
        { id: Category.hotkeys, icon: @image-url("../assets/icons/keyboard.svg") },
        { id: Category.about, icon: @image-url("../assets/icons/info_circle.svg") },
    ];
    // A recording ends when its row goes away (FR-016).
    // The folder dialog's warning and the desktop's one belong to the click that showed them.
    changed category => {
        Prefs.hotkey-cancel();
        Prefs.folder-picker-missing = false;
        Prefs.hotkeys-desktop-dialog-missing = false;
    }

    // The category column runs the panel's full height on the base tone (FR-034).
    property <length> nav-pad: 10px;
    property <length> nav-width: root.compact ? 44px + 2 * root.nav-pad : 210px;
    // Where the rows start: under the close control.
    property <length> content-y: 52px;

    fill: Theme.c.raised;
    accessible-role: groupbox;
    accessible-label: @tr("Settings");

    // Clicks on the panel stay on it.
    TouchArea { }

    // The categories come first in the focus order, then the rows, then the close control.
    Rectangle {
        x: 0;
        y: 0;
        width: root.nav-width;
        height: root.height;
        border-top-left-radius: root.radius;
        border-bottom-left-radius: root.radius;
        background: Theme.c.base;

        VerticalLayout {
            padding: root.nav-pad;
            spacing: 4px;
            alignment: start;

            // The panel's title; compact, only its icon.
            HorizontalLayout {
                padding-left: root.compact ? (44px - 22px) / 2 : 12px;
                padding-right: 12px;
                padding-top: 10px;
                padding-bottom: 16px;
                spacing: 10px;

                VerticalLayout {
                    alignment: center;
                    horizontal-stretch: 0;
                    Image {
                        width: 22px;
                        height: 22px;
                        source: @image-url("../assets/icons/settings.svg");
                        colorize: Theme.c.text;
                        accessible-role: none;
                    }
                }

                if !root.compact: Text {
                    text: @tr("Settings");
                    color: Theme.c.text;
                    font-size: Theme.text-l;
                    font-weight: 600;
                    vertical-alignment: center;
                    overflow: elide;
                    accessible-role: none;
                }
            }

            for entry in root.categories: CategoryItem {
                id: entry.id;
                icon: entry.icon;
                compact: root.compact;
                selected: entry.id == root.category;
                chosen => { root.category = entry.id; }
            }
        }
    }

    // The Audio category's heading, tabs and column headers stay while its rows scroll.
    audio-head := VerticalLayout {
        x: root.nav-width;
        y: root.content-y;
        width: root.width - root.nav-width;
        height: root.category == Category.audio ? self.preferred-height : 0;
        visible: root.category == Category.audio;

        Heading {
            text: @tr("Exclusive mode");
            line: @tr("Lowest delay. No other app can use the device while the preview does.");
        }

        Tabs {
            label: @tr("Exclusive mode");
            tabs: [@tr("Inputs"), @tr("Outputs")];
            focusable: root.category == Category.audio;
            current <=> root.audio-tab;
        }

        ColumnHeads { }
    }

    // The rows run the content's full width; their own padding keeps the text off the edges.
    rows := Flickable {
        x: root.nav-width;
        y: root.content-y + audio-head.height;
        width: root.width - root.nav-width;
        height: root.height - self.y;
        content-height: max(self.height, content.preferred-height);

        content := VerticalLayout {
            alignment: start;
            padding-bottom: 16px;

            if root.category == Category.general: ToggleRow {
                text: @tr("Start in fullscreen");
                checked <=> Prefs.start-fullscreen;
                toggled(on) => { Prefs.start-fullscreen-changed(on); }
            }

            if root.category == Category.general && Prefs.tray-available: ToggleRow {
                text: @tr("Keep in tray when closed");
                checked <=> Prefs.keep-in-tray;
                toggled(on) => { Prefs.keep-in-tray-changed(on); }
            }

            if root.category == Category.general: ToggleRow {
                text: @tr("Start with the system");
                checked <=> Prefs.start-with-system;
                toggled(on) => { Prefs.start-with-system-changed(on); }
            }

            // Every corner drawn with the button's icon: the frame and the mark in that corner.
            if root.category == Category.general: SelectRow {
                text: @tr("Notification position");
                last: true;
                icon-only: true;
                columns: 2;
                items: [
                    {
                        text: @tr("Top left"),
                        icon: @image-url("../assets/icons/corner_frame.svg"),
                        accent: @image-url("../assets/icons/corner_mark_top_left.svg"),
                    },
                    {
                        text: @tr("Top right"),
                        icon: @image-url("../assets/icons/corner_frame.svg"),
                        accent: @image-url("../assets/icons/corner_mark_top_right.svg"),
                    },
                    {
                        text: @tr("Bottom left"),
                        icon: @image-url("../assets/icons/corner_frame.svg"),
                        accent: @image-url("../assets/icons/corner_mark_bottom_left.svg"),
                    },
                    {
                        text: @tr("Bottom right"),
                        icon: @image-url("../assets/icons/corner_frame.svg"),
                        accent: @image-url("../assets/icons/corner_mark_bottom_right.svg"),
                    },
                ];
                current <=> Prefs.notification-position;
                selected(index) => { Prefs.notification-position-changed(index); }
            }

            if root.category == Category.appearance: SelectRow {
                text: @tr("Language");
                items: Prefs.languages;
                current <=> Prefs.language;
                selected(index) => { Prefs.language-changed(index); }
            }

            if root.category == Category.appearance: SelectRow {
                text: @tr("Theme");
                last: true;
                items: [{ text: @tr("Automatic") }, { text: @tr("Dark") }, { text: @tr("Light") }];
                current <=> Prefs.theme;
                selected(index) => { Prefs.theme-changed(index); }
            }

            if root.category == Category.preview: SegmentedRow {
                text: @tr("Video background");
                options: [@tr("Theme"), @tr("Black")];
                current <=> Prefs.background;
                selected(index) => { Prefs.background-changed(index); }
            }

            if root.category == Category.preview: ToggleRow {
                text: @tr("Watermark");
                checked <=> Prefs.watermark;
                toggled(on) => { Prefs.watermark-changed(on); }
            }

            if root.category == Category.preview: SegmentedRow {
                text: @tr("Video shadow");
                options: [@tr("Always"), @tr("With ambient light"), @tr("Off")];
                current <=> Prefs.shadow;
                selected(index) => { Prefs.shadow-changed(index); }
            }

            if root.category == Category.preview: SegmentedRow {
                text: @tr("Presentation");
                last: true;
                options: [@tr("Lowest latency"), @tr("Follow the monitor")];
                tooltip: @tr("Only matters with variable refresh (G-SYNC, FreeSync)");
                current <=> Prefs.presentation;
                selected(index) => { Prefs.presentation-changed(index); }
            }

            if root.category == Category.audio: VerticalLayout {
                for endpoint[index] in root.audio-tab == 0 ? Prefs.audio-inputs : Prefs.audio-outputs: EndpointRow {
                    endpoint: endpoint;
                    last: index == (root.audio-tab == 0 ? Prefs.audio-inputs : Prefs.audio-outputs).length - 1;
                    toggled(on) => { Prefs.exclusive-changed(endpoint.id, on); }
                }
            }

            if root.category == Category.folders: FolderRow {
                last: true;
                change => { Prefs.screenshot-folder-change(); }
                open => { Prefs.screenshot-folder-open(); }
                reset => { Prefs.screenshot-folder-reset(); }
            }

            // Where global keys cannot work (Wayland without the portal, FR-012).
            if root.category == Category.hotkeys && Prefs.hotkeys-window-only: VerticalLayout {
                padding-left: Rows.pad;
                padding-right: Rows.pad;
                padding-top: Theme.gap-s;
                padding-bottom: Theme.gap-s;

                Text {
                    text: @tr("Works only while CapturaX is focused");
                    color: Theme.c.text-muted;
                    font-size: Theme.text-m;
                    wrap: word-wrap;
                }
            }

            // The desktop owns the keys and offers no way to open its settings.
            if root.category == Category.hotkeys && Prefs.hotkeys-desktop-dialog-missing: VerticalLayout {
                padding-left: Rows.pad;
                padding-right: Rows.pad;
                padding-top: Theme.gap-s;
                padding-bottom: Theme.gap-s;

                Text {
                    text: @tr("Change it in the system settings");
                    color: Theme.c.warn;
                    font-size: Theme.text-m;
                    wrap: word-wrap;
                }
            }

            if root.category == Category.hotkeys: VerticalLayout {
                for row[index] in Prefs.hotkeys: HotkeyRow {
                    data: row;
                    last: index == Prefs.hotkeys.length - 1;
                    record => { Prefs.hotkey-record(row.action); }
                    clear => { Prefs.hotkey-clear(row.action); }
                    reset => { Prefs.hotkey-reset(row.action); }
                }
            }

            if root.category == Category.about: VerticalLayout {
                padding-left: Rows.pad;
                padding-right: Rows.pad;
                padding-top: Theme.gap-m;
                spacing: Theme.gap-s;

                // The wordmark in the theme's text color (FR-006), in its aspect ratio (816 × 199.89).
                Image {
                    source: Theme.dark ? @image-url("../../../brand/CapturaX-light.svg")
                        : @image-url("../../../brand/CapturaX-dark.svg");
                    width: 32px * 816 / 199.89;
                    height: 32px;
                    accessible-role: image;
                    accessible-label: Texts.app-name;
                }

                Text {
                    text: @tr("Version {}", Prefs.version);
                    color: Theme.c.text-muted;
                    font-size: Theme.text-m;
                }
            }
        }
    }

    // Position indicator, as the menus' (menu.slint), only while the rows scroll; it ends a corner
    // radius above the panel's bottom, clear of the rounded corner.
    if rows.content-height > rows.height: Rectangle {
        property <length> track: rows.height - Theme.gap-s - root.radius;
        x: root.width - self.width - 6px;
        y: rows.y + Theme.gap-s
            + (self.track - self.height) * (-rows.content-y / (rows.content-height - rows.height));
        width: 4px;
        height: max(24px, self.track * rows.height / rows.content-height);
        border-radius: self.width / 2;
        background: Theme.c.text-faint;
    }

    // Last, so it is last in the focus order: the close control at the content's top right.
    IconButton {
        x: root.width - self.width - 8px;
        y: 8px;
        size: 36px;
        icon-size: 18px;
        icon: @image-url("../assets/icons/close.svg");
        tooltip: @tr("Close (Esc)");
        tooltip-side: Side.bottom;
        clicked => { root.close(); }
    }
}
