// Menus live in the window's top layer (plan, UI structure), ported from the stack spike's
// `dropdown.slint`. A control opens one through `Menus.show` with its rectangle; `MenuLayer`,
// drawn last in main.slint, places it: below the control and aligned to its left; if it does not
// fit below, above; if it does not fit to the right, aligned to the control's right edge (plan,
// Menu placement; FR-010). A menu taller than the room it gets scrolls. One menu is open at a time.
// Keys: Up, Down, Home, End move, skipping headers and disabled items; Enter or Space picks; Esc
// or Tab closes (FR-020). Rows as the spike's dropdown menu (research R13): group headers 30 px in
// faint text, items 36 px, 48 px with their detail on a second line; the menu slides open.
import { Theme } from "../theme.slint";
import { Raised } from "raised.slint";
import { FocusRing } from "focus-ring.slint";
import { Tag } from "tag.slint";

// One row of a menu. Every field but `text` may be left out: an empty `kind` is an item.
export struct MenuItem {
    text: string,
    // `item` (or empty) or `header`: a header names the group below it and cannot be picked.
    kind: string,
    // A second line under the text.
    detail: string,
    // The frame rate tag ("60 FPS"), after the detail line when there is one, else after the text.
    rate: string,
    // The name tag ("Full HD") and its ratio family (`16:9`, `custom`), then the aspect tag.
    tag: string,
    tag-kind: string,
    aspect: string,
    // Shown but not selectable (default false, so a menu built without it is all enabled).
    disabled: bool,
}

export global Menus {
    out property <bool> open: self.owner != 0;
    // The control that opened the menu, by the id from `new-id`; 0 when closed.
    out property <int> owner;
    out property <[MenuItem]> items;
    // The item marked as chosen, -1 for none.
    out property <int> current;
    // The item under the pointer or the keyboard.
    in-out property <int> highlighted;
    // The control's rectangle in window coordinates.
    out property <length> anchor-x;
    out property <length> anchor-y;
    out property <length> anchor-width;
    out property <length> anchor-height;
    // The narrowest the menu may be (the dropdown look asks for 320 px).
    out property <length> min-width: 160px;
    // The last pick: its owner, its item, and a count that changes on every pick.
    out property <int> picked-owner;
    out property <int> picked-index;
    out property <int> picks;
    property <int> ids;

    // The index of the next selectable item from `from` (excluded) in direction `step` (1 or -1),
    // or `from` when there is none; set by Rust (app/src/ui.rs, `next_selectable`), since Slint
    // functions cannot loop.
    pure callback next-selectable(items: [MenuItem], from: int, step: int) -> int;
    // The top of row `index` in the list (`index` = the count: the list's height plus one
    // spacing); set by Rust (`item_top`) with the row heights below and a 2 px spacing.
    pure callback item-top(items: [MenuItem], index: int) -> length;
    // `items` after a group header named `title` (the icon look's menu); set by Rust, since Slint
    // cannot join arrays.
    pure callback with-header(title: string, items: [MenuItem]) -> [MenuItem];

    public pure function selectable(item: MenuItem) -> bool {
        return item.kind != "header" && !item.disabled;
    }

    // A new owner id for a control that opens menus; call it once, from `init`.
    public function new-id() -> int {
        self.ids += 1;
        return self.ids;
    }

    public function show(owner: int, items: [MenuItem], current: int, x: length, y: length, width: length, height: length,
        min-width: length) {
        self.items = items;
        self.min-width = min-width;
        self.current = current;
        self.highlighted = current >= 0 ? current : self.next-selectable(items, -1, 1);
        self.anchor-x = x;
        self.anchor-y = y;
        self.anchor-width = width;
        self.anchor-height = height;
        self.owner = owner;
    }

    // The open menu's items changed (a device came or left): shown at once; the highlight stays
    // unless its row is gone or no longer selectable.
    public function update(items: [MenuItem], current: int) {
        self.items = items;
        self.current = current;
        if (self.highlighted < 0 || self.highlighted >= items.length || !self.selectable(items[self.highlighted])) {
            self.highlighted = current >= 0 ? current : self.next-selectable(items, -1, 1);
        }
    }

    public function pick(index: int) {
        if (self.open && index >= 0 && index < self.items.length && self.selectable(self.items[index])) {
            self.picked-owner = self.owner;
            self.picked-index = index;
            self.picks += 1;
            self.close();
        }
    }

    public function close() {
        self.owner = 0;
    }
}

// Fills the window; place it in the top layer with the window's size, shown while `Menus.open`.
export component MenuLayer inherits Rectangle {
    // Between the window's edges and the menu, and between the control and the menu.
    property <length> margin: 8px;
    property <length> space: 4px;
    property <length> pad: 6px;
    // Must match `item_top` in app/src/ui.rs.
    property <length> spacing: 2px;
    property <int> count: Menus.items.length;
    property <length> content-height: max(0px, Menus.item-top(Menus.items, root.count) - root.spacing);
    property <length> natural-height: root.content-height + 2 * root.pad;
    property <length> ax: Menus.anchor-x;
    property <length> ay: Menus.anchor-y;
    property <length> aw: Menus.anchor-width;
    property <length> ah: Menus.anchor-height;
    property <length> room-below: root.height - root.margin - (root.ay + root.ah + root.space);
    property <length> room-above: root.ay - root.space - root.margin;
    property <bool> below: root.natural-height <= root.room-below || root.room-below >= root.room-above;
    property <length> menu-height: max(0px, min(root.natural-height, root.below ? root.room-below : root.room-above));
    property <length> menu-width: min(max(root.aw, rows.preferred-width + 2 * root.pad, Menus.min-width), root.width - 2 * root.margin);
    property <bool> right-aligned: root.ax + root.menu-width > root.width - root.margin;

    // The menu takes the keyboard when it opens or another control's menu replaces it.
    property <int> owner: Menus.owner;
    changed owner => { keys.focus(); }
    // Slides 8 px away from its control while it fades in.
    property <float> appear: 0;
    animate appear { duration: Theme.quick; easing: ease-out; }
    init => {
        keys.focus();
        self.appear = 1;
    }

    // Keeps the highlighted item inside the visible part of the list.
    property <int> highlighted: Menus.highlighted;
    changed highlighted => {
        let top = Menus.item-top(Menus.items, self.highlighted);
        let bottom = Menus.item-top(Menus.items, self.highlighted + 1) - self.spacing;
        if (top < -scroller.content-y) {
            scroller.content-y = -top;
        } else if (bottom > -scroller.content-y + scroller.height) {
            scroller.content-y = -(bottom - scroller.height);
        }
    }

    // A click anywhere else closes the menu and goes no further.
    TouchArea {
        clicked => { Menus.close(); }
    }

    keys := FocusScope {
        key-pressed(event) => {
            if (event.text == Key.DownArrow) {
                Menus.highlighted = Menus.next-selectable(Menus.items, Menus.highlighted, 1);
            } else if (event.text == Key.UpArrow) {
                Menus.highlighted = Menus.next-selectable(Menus.items, Menus.highlighted, -1);
            } else if (event.text == Key.Home) {
                Menus.highlighted = Menus.next-selectable(Menus.items, -1, 1);
            } else if (event.text == Key.End) {
                Menus.highlighted = Menus.next-selectable(Menus.items, root.count, -1);
            } else if (event.text == Key.Return || event.text == Key.Space) {
                Menus.pick(Menus.highlighted);
            } else if (event.text == Key.Escape || event.text == Key.Tab || event.text == Key.Backtab) {
                Menus.close();
            } else {
                return reject;
            }
            accept
        }
    }

    menu := Raised {
        fill: Theme.c.raised;
        x: root.right-aligned ? max(root.margin, root.ax + root.aw - root.menu-width) : root.ax;
        y: root.below ? root.ay + root.ah + root.space + 8px * root.appear
            : root.ay - root.space - root.menu-height - 8px * root.appear;
        width: root.menu-width;
        height: root.menu-height;
        opacity: root.appear;
        accessible-role: list;

        property <bool> scrolls: root.content-height > scroller.height;
        property <length> bar-width: 4px;

        // Eats clicks between the items so they do not reach the layer behind.
        TouchArea { }

        // Inset by the padding so the clip stays inside the rounded corners.
        scroller := Flickable {
            x: root.pad;
            y: root.pad;
            width: parent.width - 2 * root.pad - (menu.scrolls ? menu.bar-width + root.pad : 0);
            height: parent.height - 2 * root.pad;
            content-height: root.content-height;

            rows := VerticalLayout {
                width: scroller.width;
                spacing: root.spacing;

                for item[i] in Menus.items: row := Rectangle {
                    property <bool> header: item.kind == "header";
                    property <bool> selectable: Menus.selectable(item);
                    height: self.header ? 30px : item.detail != "" ? 48px : 36px;
                    border-radius: Theme.radius-s;
                    background: !self.selectable ? transparent
                        : i == Menus.current ? Theme.c.press
                        : i == Menus.highlighted ? Theme.c.hover
                        : transparent;
                    accessible-role: list-item;
                    accessible-label: item.text;
                    accessible-description: item.detail;
                    accessible-enabled: self.selectable;
                    accessible-item-selected: i == Menus.current;
                    accessible-item-index: i;
                    accessible-action-default => { Menus.pick(i); }

                    item-area := TouchArea {
                        enabled: row.selectable;
                        clicked => { Menus.pick(i); }
                        changed has-hover => {
                            if (self.has-hover) {
                                Menus.highlighted = i;
                            }
                        }
                    }

                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        spacing: 10px;

                        VerticalLayout {
                            alignment: center;
                            horizontal-stretch: 1;
                            // Room between the text and its detail line with the rate tag.
                            spacing: 4px;
                            HorizontalLayout {
                                alignment: start;
                                spacing: 6px;
                                Text {
                                    text: item.text;
                                    color: row.header || item.disabled ? Theme.c.text-faint : Theme.c.text;
                                    font-size: row.header ? Theme.text-s : Theme.text-m;
                                    font-weight: row.header ? 600 : 400;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                                if item.detail == "" && item.rate != "": Tag { value: item.rate; kind: "rate"; }
                            }
                            if item.detail != "": HorizontalLayout {
                                alignment: start;
                                spacing: 6px;
                                Text {
                                    text: item.detail;
                                    color: item.disabled ? Theme.c.text-faint : Theme.c.text-muted;
                                    font-size: Theme.text-s;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                                if item.rate != "": Tag { value: item.rate; kind: "rate"; }
                            }
                        }

                        if item.tag != "" || item.aspect != "": HorizontalLayout {
                            alignment: end;
                            spacing: 6px;
                            horizontal-stretch: 0;
                            VerticalLayout {
                                alignment: center;
                                Tag { value: item.tag; kind: item.tag-kind; }
                            }
                            VerticalLayout {
                                alignment: center;
                                Tag { value: item.aspect; kind: "aspect"; }
                            }
                        }
                    }

                    FocusRing {
                        focused: row.selectable && i == Menus.highlighted;
                        radius: Theme.radius-s;
                        // Inside the item, so the list's clip does not cut it.
                        offset: -Theme.focus-ring;
                    }
                }
            }
        }

        // Position indicator, only when the list scrolls.
        if menu.scrolls: Rectangle {
            property <length> track: menu.height - 2 * Theme.radius-m;
            x: parent.width - root.pad - self.width;
            y: Theme.radius-m + (self.track - self.height) * (-scroller.content-y / (root.content-height - scroller.height));
            width: menu.bar-width;
            height: max(24px, self.track * scroller.height / root.content-height);
            border-radius: self.width / 2;
            background: Theme.c.text-faint;
        }
    }
}
