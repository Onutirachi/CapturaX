// A select: an opaque control showing the chosen item and a chevron that opens a menu of the
// items in the top layer (menu.slint), ported from the stack spike's `dropdown.slint`. Enter,
// Space, Up or Down opens it from the keyboard; the focus comes back here when it closes (FR-020).
// Two looks: plain (36 px, for the settings panel's 44 px rows) and, with a `title`, the spike's
// dropdown (research R13): a raised control 48 px tall with its title inside, above the chosen
// value in bold, its frame rate tag (when it is on the item's first line) and its name tag, whose
// menu is at least 320 px wide.
import { Theme } from "../theme.slint";
import { FocusRing } from "focus-ring.slint";
import { Menus, MenuItem } from "menu.slint";
import { Tag } from "tag.slint";

export component Select inherits Rectangle {
    in property <[MenuItem]> items;
    in-out property <int> current;
    in property <bool> enabled: true;
    // False keeps it out of the Tab order (behind the settings panel).
    in property <bool> focusable: true;
    // Shown in the button instead of the chosen item's text when not empty ("Auto (Full)").
    in property <string> shown;
    // The small title inside the control (the dropdown look); empty for the plain look.
    in property <string> title;
    // The setting's name, for screen readers.
    in property <string> label;
    out property <bool> has-focus: focus.has-focus;
    callback selected(int);

    property <bool> titled: root.title != "";
    property <bool> valid: root.current >= 0 && root.current < root.items.length;
    property <string> chosen: root.valid ? root.items[root.current].text : "";
    property <string> tag: root.valid ? root.items[root.current].tag : "";
    property <string> tag-kind: root.valid ? root.items[root.current].tag-kind : "";
    // The rate tag shows when it follows the item's text (no detail line).
    property <string> rate: root.valid && root.items[root.current].detail == "" ? root.items[root.current].rate : "";

    property <int> id;
    init => { self.id = Menus.new-id(); }
    property <bool> open: self.id != 0 && Menus.owner == self.id;
    // Changes on each pick from this select's menu.
    property <int> picks: Menus.picked-owner == self.id ? Menus.picks : 0;
    changed picks => {
        if (self.picks != 0) {
            self.current = Menus.picked-index;
            self.selected(self.current);
        }
    }
    // New items while the menu is open (a device came or left) reach the menu at once; a select
    // left with no item closes it.
    changed items => {
        if (self.open) {
            if (self.items.length > 0) {
                Menus.update(self.items, self.current);
            } else {
                Menus.close();
            }
        }
    }
    changed enabled => {
        if (!self.enabled && self.open) {
            Menus.close();
        }
    }
    // Closed (not replaced by another menu): the keyboard comes back here.
    changed open => {
        if (!self.open && !Menus.open) {
            focus.focus();
        }
    }

    public function open-menu() {
        if (root.enabled && root.items.length > 0) {
            Menus.show(root.id, root.items, root.current, root.absolute-position.x, root.absolute-position.y,
                root.width, root.height, root.titled ? 320px : 160px);
        }
    }

    min-width: 120px;
    height: root.titled ? 48px : 36px;
    border-radius: root.titled ? Theme.radius-m : Theme.radius-s;
    // The dropdown look draws its fill with its shadow (as `Raised`).
    background: root.titled ? transparent : Theme.c.top;
    opacity: root.enabled ? 1 : 0.35;

    accessible-role: combobox;
    accessible-label: root.label;
    accessible-value: root.shown != "" ? root.shown : root.chosen;
    accessible-enabled: root.enabled;
    accessible-expandable: true;
    accessible-expanded: root.open;
    accessible-action-default => { root.open-menu(); }
    accessible-action-expand => { root.open-menu(); }

    forward-focus: focus;

    if root.titled: Image {
        x: -36px;
        y: -36px;
        width: root.width + 72px;
        height: root.height + 72px + 10px;
        source: Theme.surface(root.width, root.height, 1px / 1phx, Theme.c.top, Theme.c.shadow);
    }

    // Hover and open tint over the fill; the dropdown look has no pressed tint (as the spike).
    Rectangle {
        border-radius: root.border-radius;
        background: area.pressed && !root.titled ? Theme.c.press
            : area.has-hover || root.open ? Theme.c.hover
            : transparent;
        animate background { duration: Theme.quick; }
    }

    area := TouchArea {
        enabled: root.enabled;
        clicked => { root.open-menu(); }
    }

    focus := FocusScope {
        enabled: root.enabled && root.focusable;
        focus-on-click: false;
        key-pressed(event) => {
            if (event.text == Key.Return || event.text == Key.Space || event.text == Key.DownArrow
                || event.text == Key.UpArrow) {
                root.open-menu();
                return accept;
            }
            reject
        }
    }

    HorizontalLayout {
        padding-left: root.titled ? 14px : Theme.gap-m;
        padding-right: root.titled ? 10px : Theme.gap-s + 4px;
        spacing: Theme.gap-s;

        VerticalLayout {
            alignment: center;
            spacing: 1px;
            horizontal-stretch: 1;

            if root.titled: Text {
                text: root.title;
                // The spike's faint tone falls below 4.5:1 on the hovered control (FR-018).
                color: Theme.c.text-muted;
                font-size: 11px;
                font-weight: 600;
                overflow: elide;
                accessible-role: none;
            }

            HorizontalLayout {
                spacing: 8px;

                Text {
                    text: root.shown != "" ? root.shown : root.chosen;
                    color: Theme.c.text;
                    font-size: Theme.text-m;
                    font-weight: root.titled ? 600 : 400;
                    vertical-alignment: center;
                    overflow: elide;
                    horizontal-stretch: 1;
                }

                if root.titled && root.rate != "": VerticalLayout {
                    alignment: center;
                    horizontal-stretch: 0;
                    Tag { value: root.rate; kind: "rate"; }
                }

                if root.titled && root.tag != "": VerticalLayout {
                    alignment: center;
                    horizontal-stretch: 0;
                    Tag { value: root.tag; kind: root.tag-kind; }
                }
            }
        }

        VerticalLayout {
            alignment: center;
            horizontal-stretch: 0;
            Image {
                source: @image-url("../assets/icons/chevron.svg");
                width: 16px;
                height: 16px;
                colorize: Theme.c.text-muted;
                transform-rotation: root.open ? 180deg : 0deg;
                animate transform-rotation { duration: Theme.quick; }
            }
        }
    }

    FocusRing {
        focused: focus.has-focus;
        radius: root.border-radius;
    }
}
