// Every text Rust needs (notices, tray menu, system messages), by identifier (research R7). Rust
// never builds user-facing text: it reads these, so every text has one catalog.
export global Texts {
    out property <string> app-name: @tr("CapturaX");
    // System message `already-open`: a second start found CapturaX open, but the platform did not
    // let the window come to the front (Wayland).
    // Tray menu (FR-014a).
    out property <string> tray-open: @tr("Open");
    out property <string> tray-quit: @tr("Quit");
    // The first entry of the settings panel's Language select, before the languages' own names.
    out property <string> automatic: @tr("Automatic");
    out property <string> already-open: @tr("CapturaX is already open. Its window is shown, but the system did not let it come to the front.");
}
