// Every text Rust needs (notices, tray menu, system messages), by identifier (research R7). Rust
// never builds user-facing text: it reads these, so every text has one catalog.
export global Texts {
    out property <string> app-name: @tr("CapturaX");
    // System message `already-open` (a warning): a second start found CapturaX open, but the
    // platform did not let the window come to the front (Wayland).
    // Tray menu (FR-014a).
    out property <string> tray-open: @tr("Open");
    out property <string> tray-quit: @tr("Quit");
    // The first entry of the settings panel's Language select, before the languages' own names.
    out property <string> automatic: @tr("Automatic");
    // Notices about the settings location (FR-027, FR-028, FR-030): a title, and a text with the
    // folder or file it names.
    out property <string> settings-fallback-title: @tr("Settings in another folder");
    out property <string> settings-not-kept-title: @tr("Settings will not be kept");
    out property <string> settings-damaged-title: @tr("Settings damaged");
    public pure function settings-fallback(folder: string) -> string {
        @tr("CapturaX cannot write to its own folder, so settings are kept in this folder:\n{}", folder)
    }
    public pure function settings-not-kept() -> string {
        @tr("CapturaX cannot write its settings anywhere. Changes will be lost when it closes.")
    }
    public pure function settings-damaged(kept-as: string) -> string {
        @tr("The settings file was damaged. Default settings are in use; the old file was kept as {}.", kept-as)
    }
    public pure function settings-unreadable() -> string {
        @tr("The settings file could not be read. Default settings are in use.")
    }
    // The preview's state messages (FR-019, research R13): a title, then a one-line detail.
    out property <string> preview-no-devices: @tr("No devices");
    out property <string> preview-no-devices-detail: @tr("Connect a video device");
    public pure function preview-disconnected(device: string) -> string {
        @tr("{} disconnected", device)
    }
    out property <string> preview-disconnected-detail: @tr("Waiting to reconnect");
    // Blocked on Windows (the desktop apps camera switch is off).
    out property <string> preview-blocked: @tr("Access blocked");
    out property <string> preview-blocked-detail: @tr("Desktop app permission is off");
    // Blocked on Linux names the node ("Cannot open /dev/video0"); Failed names the device.
    public pure function preview-cannot-open(device: string) -> string {
        @tr("Cannot open {}", device)
    }
    out property <string> preview-no-permission: @tr("No permission to use the device");
    out property <string> preview-in-use: @tr("In use");
    public pure function preview-in-use-detail(device: string) -> string {
        @tr("{} is being used elsewhere", device)
    }
    out property <string> preview-no-signal: @tr("No signal");
    out property <string> preview-no-signal-detail: @tr("No video signal detected");
    // Device notices (FR-027), in the app's balloon and as system notifications, with **Open** on
    // a device that did not open by itself.
    public pure function notice-connected(device: string) -> string {
        @tr("{} connected", device)
    }
    public pure function notice-reconnected(device: string) -> string {
        @tr("{} reconnected", device)
    }
    public pure function notice-disconnected(device: string) -> string {
        @tr("{} disconnected", device)
    }
    out property <string> notice-open: @tr("Open");
    // Screenshot notices (screenshot FR-008), in the same balloon and system notifications, with
    // **Show** on a saved file and **Settings** when the folder failed.
    out property <string> notice-screenshot-saved: @tr("Screenshot saved");
    out property <string> notice-screenshot-saved-not-copied: @tr("Screenshot saved, not copied");
    public pure function notice-screenshot-copied-not-saved(reason: string) -> string {
        @tr("Couldn't save the screenshot: {}. Copied to the clipboard", reason)
    }
    public pure function notice-screenshot-failed(reason: string) -> string {
        @tr("Couldn't take the screenshot: {}", reason)
    }
    // Why a screenshot failed, a few words inside the two texts above.
    out property <string> screenshot-folder-not-found: @tr("folder not found");
    out property <string> screenshot-no-permission: @tr("no permission");
    out property <string> screenshot-disk-full: @tr("disk full");
    out property <string> screenshot-write-error: @tr("write error");
    out property <string> screenshot-image-error: @tr("image error");
    out property <string> notice-show: @tr("Show");
    // The hotkey actions' names (screenshot FR-013), also given to the desktop's shortcut list.
    out property <string> hotkey-screenshot: @tr("Screenshot");
    // Why the Hotkeys category refused a key (FR-016): the rules, with the platform's name of the
    // Super key (Win, Super), and the action that already has it.
    public pure function hotkey-not-allowed(super-key: string) -> string {
        @tr("Use F1–F24, or a key with Ctrl, Alt or {}", super-key)
    }
    public pure function hotkey-taken(action: string) -> string {
        @tr("Already used by {}", action)
    }
    // The names of the keys that are not a letter, a digit or F1–F24, as hotkeys show them.
    out property <string> key-space: @tr("Space");
    out property <string> key-insert: @tr("Insert");
    out property <string> key-delete: @tr("Delete");
    out property <string> key-home: @tr("Home");
    out property <string> key-end: @tr("End");
    out property <string> key-page-up: @tr("Page Up");
    out property <string> key-page-down: @tr("Page Down");
    out property <string> key-up: @tr("Up");
    out property <string> key-down: @tr("Down");
    out property <string> key-left: @tr("Left");
    out property <string> key-right: @tr("Right");
    out property <string> key-pause: @tr("Pause");
    out property <string> key-print-screen: @tr("Print Screen");
    out property <string> notice-settings: @tr("Settings");
    // The mode menu (FR-007): its group headers, the automatic modes' names, and the detail line of
    // an automatic choice, its name then the mode it opens ("Auto max FPS · 1920 × 1080 · 120").
    out property <string> modes-automatic: @tr("Automatic");
    out property <string> modes-native: @tr("Modes");
    out property <string> mode-auto-source: @tr("Auto source");
    out property <string> mode-auto-max-resolution: @tr("Auto max resolution");
    out property <string> mode-auto-max-fps: @tr("Auto max FPS");
    public pure function mode-auto-detail(choice: string, mode: string) -> string {
        @tr("{} · {}", choice, mode)
    }
    // The frame rate tag ("60 FPS") and the name tag of a size outside the standards.
    public pure function rate(fps: string) -> string {
        @tr("{} FPS", fps)
    }
    out property <string> custom-resolution: @tr("Custom");
    // The Audio menu (preview audio FR-008, FR-009, FR-022): its group headers, the Auto row with
    // the paired input's name, No audio, and the System default row with the default output's
    // name (without a name when the system has no output).
    out property <string> audio-inputs: @tr("Input");
    out property <string> audio-outputs: @tr("Output");
    public pure function audio-auto(input: string) -> string {
        @tr("Auto ({})", input)
    }
    out property <string> audio-auto-none: @tr("Auto (none)");
    out property <string> audio-no-audio: @tr("No audio");
    public pure function audio-system-default(output: string) -> string {
        @tr("System default ({})", output)
    }
    out property <string> audio-system-default-unnamed: @tr("System default");
    // The Audio states (preview audio FR-017, FR-022): the tags before the select's value ("In
    // use" is `preview-in-use`), and the titles and details at the top of its menu that the
    // video states do not already have; the actions are the state message's.
    out property <string> audio-tag-disconnected: @tr("Disconnected");
    out property <string> audio-tag-blocked: @tr("Blocked");
    out property <string> audio-tag-failed: @tr("Failed");
    out property <string> audio-no-pair: @tr("No paired audio");
    out property <string> audio-choose-input: @tr("Choose an input");
    out property <string> audio-device-disconnected: @tr("Device disconnected");
    out property <string> audio-device-in-use: @tr("Device in use");
    out property <string> audio-cannot-open: @tr("Cannot open");
    out property <string> audio-using-default: @tr("Using the system default");
    // An exclusive device refused exclusive mode and plays shared (User Story 4), and the tag of
    // a side playing exclusive.
    out property <string> audio-exclusive-unavailable: @tr("Exclusive mode unavailable");
    out property <string> audio-tag-exclusive: @tr("Exclusive");
    out property <string> try-again: @tr("Try again");
    out property <string> open-privacy: @tr("Open privacy settings");
    // System message `renderer-unavailable` (FR-036): no renderer could start; the app exits.
    out property <string> renderer-unavailable: @tr("CapturaX cannot start because no graphics renderer works on this computer. Update the graphics driver and try again.");
    out property <string> already-open: @tr("CapturaX is already open.");
}
